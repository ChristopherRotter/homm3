+//! Failing tests of the E04b robustness review (T11b) on the harvested packs: the findings
+//! F-robust-3 and F-robust-2 with the real spells, creatures and battlefields. Kept as a patch
+//! file in the review's scratch folder, not committed.
+
+use h3_battle::{
+    BattleState, CastTarget, CastTargets, Command, Hex, NoopSink, apply, cast_targets,
+    castable_spells, generate_obstacles,
+};
+use h3_content::{Formation, HeroTypeId, Ruleset, SchoolId, SpellScope};
+use h3_contracts::{
+    Army, ArmyStack, BattleEffect, BattleHero, BattleSetup, BattleSide, Obstacle, Rate,
+};
+use h3_kernel::{Rng, StreamId};
+
+fn faithful() -> Ruleset {
+    h3_pack::compile(
+        &[h3_pack::SOD_PACK, h3_pack::AB_PACK, h3_pack::BASE_PACK],
+        "base:faithful",
+    )
+    .unwrap()
+}
+
+/// Ten Pikemen each, the attacker led by `hero`.
+fn setup(r: &Ruleset, hero: BattleHero, obstacles: Vec<Obstacle>) -> BattleSetup {
+    let army = || Army {
+        stacks: vec![ArmyStack {
+            slot: 0,
+            creature: r.creature_by_key("base:pikeman").unwrap(),
+            count: 10,
+        }],
+    };
+    BattleSetup {
+        attacker: army(),
+        defender: army(),
+        obstacles,
+        heroes: [Some(hero), None],
+        terrain: r.terrain_by_key("base:grass"),
+        war_machines: [vec![], vec![]],
+        formations: [Formation::Loose; 2],
+        funds: [0; 2],
+    }
+}
+
+/// F-robust-3 with the original's spells and the default profile (quirk Q-0005 on): a hero of
+/// power 20 casts Implosion (75 per power + 100) with the largest spell damage rates the seam
+/// carries for every spell and for Earth spells. The battle accepts the hero (BAT-HER-001) and
+/// lists the cast; applying it overflows in `magic::spell_damage`.
+#[test]
+fn implosion_with_huge_spell_damage_rates_does_not_overflow() {
+    let r = faithful();
+    let implosion = r.spell_by_key("base:implosion").unwrap();
+    let earth = r
+        .spell_schools()
+        .iter()
+        .position(|s| s.key.as_str() == "base:earth")
+        .and_then(SchoolId::from_index)
+        .unwrap();
+    let mut hero = BattleHero::new(HeroTypeId::from_index(0).unwrap());
+    hero.power = 20;
+    hero.magic.mana = 100;
+    hero.magic.spell_book = Some(vec![implosion]);
+    hero.effects = vec![
+        BattleEffect::SpellDamage {
+            scope: SpellScope::All,
+            rate: Rate::bp(u32::MAX),
+        },
+        BattleEffect::SpellDamage {
+            scope: SpellScope::School(earth),
+            rate: Rate::bp(u32::MAX),
+        },
+    ];
+    let mut state = BattleState::new(&r, &setup(&r, hero, vec![]), 1).unwrap();
+    let side = BattleSide::Attacker;
+    assert!(castable_spells(&state, &r, side).contains(implosion));
+    let mut targets = CastTargets::new();
+    cast_targets(&state, &r, side, implosion, &mut targets);
+    let target = targets.as_slice()[0];
+    let cast = Command::Cast {
+        spell: implosion,
+        target,
+        second: CastTarget::None,
+    };
+    apply(&mut state, &r, side, cast, &mut NoopSink).unwrap();
+}
+
+/// F-robust-2 on a battlefield the engine generates (grass, obstacle stream of seed 888): its
+/// fourth obstacle blocks hexes 109 and 110 from its anchor 108, which it does not block; the
+/// fifth is a one-hex obstacle placed on 108. With the default profile (quirk BAT-QUIRK-3 on) the
+/// removal of the fourth clears hex 108 too, so no hex leads to the fifth any more, and once the
+/// others are removed Remove Obstacle stays castable without a target.
+#[test]
+fn remove_obstacle_keeps_a_target_while_it_is_castable() {
+    let r = faithful();
+    let remove = r.spell_by_key("base:remove_obstacle").unwrap();
+    let grass = r.terrain_by_key("base:grass").unwrap();
+    let mut rng = Rng::for_stream(888, StreamId::OBSTACLES);
+    let obstacles = generate_obstacles(&r, grass, &mut rng);
+    let piece = |hexes: &[u8], anchor| Obstacle {
+        hexes: hexes.to_vec(),
+        anchor: Some(anchor),
+    };
+    assert_eq!(
+        obstacles[3..],
+        [piece(&[109, 110], 108), piece(&[108], 108)]
+    );
+    let mut hero = BattleHero::new(HeroTypeId::from_index(0).unwrap());
+    hero.magic.mana = 999;
+    hero.magic.spell_book = Some(vec![remove]);
+    let mut state = BattleState::new(&r, &setup(&r, hero, obstacles), 1).unwrap();
+    let side = BattleSide::Attacker;
+    let mut targets = CastTargets::new();
+    // A hex of the fourth obstacle first, then one of each other obstacle that is left.
+    for hex in [109, 122, 73, 80] {
+        assert_eq!(state.side_to_act(), Some(side));
+        let cast = Command::Cast {
+            spell: remove,
+            target: CastTarget::Hex(Hex(hex)),
+            second: CastTarget::None,
+        };
+        apply(&mut state, &r, side, cast, &mut NoopSink).unwrap();
+        // Both stacks defend: the next round, the hero may cast again.
+        apply(&mut state, &r, side, Command::Defend, &mut NoopSink).unwrap();
+        apply(
+            &mut state,
+            &r,
+            side.opponent(),
+            Command::Defend,
+            &mut NoopSink,
+        )
+        .unwrap();
+    }
+    let castable = castable_spells(&state, &r, side).contains(remove);
+    cast_targets(&state, &r, side, remove, &mut targets);
+    assert_eq!(
+        castable,
+        !targets.is_empty(),
+        "castable {castable}, targets {:?}, obstacles left {:?}",
+        targets.as_slice(),
+        state.removable_obstacles()
+    );
+}

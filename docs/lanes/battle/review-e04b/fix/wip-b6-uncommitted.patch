+// covers: BAT-MAG-004
+#[test]
+fn the_spell_damage_saturates_for_every_value_and_rate() {
+    // Every value and every rate the seam can carry, in both variants: the largest value with
+    // the largest rates comes to the largest damage, and no bit pattern of a rate's own
+    // single-precision value (the largest `f32`, an infinity, a NaN, a negative value) panics.
+    let patterns = [
+        0x7f7f_ffff,
+        0x7f80_0000,
+        0xffff_ffff,
+        0x8000_0001,
+        0x0000_0001,
+    ];
+    let rates = patterns
+        .map(|bits| Rate {
+            bp: u32::MAX,
+            single: core::num::NonZeroU32::new(bits),
+        })
+        .into_iter()
+        .chain([Rate::bp(u32::MAX), Rate::bp(0)]);
+    for profile in ["t:single", "t:faithful"] {
+        let r = ruleset_with(profile, |_| {});
+        let id = spell(&r, "bolt");
+        let titan = r.creature_by_key("t:titan").unwrap();
+        for rate in rates.clone() {
+            let mut bonuses = crate::magic::SpellBonuses {
+                all: rate,
+                school: [rate; 4],
+                ..Default::default()
+            };
+            let own = SpellBonus {
+                spell: id,
+                damage_bp: u32::MAX,
+                per_level_bp: u32::MAX,
+                level: u8::MAX,
+            };
+            bonuses.spells.push(own).unwrap();
+            let spell = (id, r.spell(id).unwrap());
+            for value in [0, 1, u64::from(u32::MAX), 1 << 48, u64::MAX] {
+                let damage =
+                    |b| crate::magic::spell_damage(&r, (spell, b), value, (titan, &[100; 4]));
+                let (caster, dealt) = damage(&bonuses);
+                let plain = damage(&crate::magic::SpellBonuses::default());
+                assert!(
+                    caster >= value && dealt == caster,
+                    "{profile} {rate:?} {value}"
+                );
+                // Without bonuses the value is the damage, but for what an `f32` cannot hold.
+                assert!(plain.0 == value || value >= 1 << 24, "{profile} {value}");
+            }
+            let all =
+                crate::magic::spell_damage(&r, (spell, &bonuses), u64::MAX, (titan, &[100; 4]));
+            assert_eq!(all, (u64::MAX, u64::MAX), "{profile} {rate:?}");
+        }
+    }
 }
 

+    let r = ruleset_with(profile, |_| {});
+    let mut h = mage(&r, &["bolt"]);
+    h.power = 255;
+    h.magic.mana = 100;
+    h.effects = vec![
+        BattleEffect::SpellDamage {
+            scope: SpellScope::All,
+            rate: all,
+        },
+        BattleEffect::SpellDamage {
+            scope: SpellScope::School(SchoolId::from_raw(0)),
+            rate: school,
+        },
+    ];
+    // The setup is sound for the battle (BAT-HER-001).
+    let s = led(
+        &r,
+        [Some(h), None],
+        &[(0, "fixed", 10)],
+        &[(0, "fixed", 10)],
+    );
+    (r, s)
+}

+/// The security reviewer's sketch for F-sec-1 part a (BAT-Q31), run to see what the engine does.
+#[test]
+#[allow(
+    clippy::disallowed_methods,
+    clippy::disallowed_types,
+    clippy::print_stderr,
+    unused_mut
+)]
+fn zz_berserk_pits() {
+    use super::support::{act, at, ruleset_with};
+    for profile in ["t:faithful", "t:pits"] {
+        let r = ruleset_with(profile, |_| {});
+        let mut s = super::spells::arena(
+            &r,
+            [None, None],
+            &[("fixed", 5, 4, 5)],
+            &[("fixed", 5, 8, 5)],
+            1,
+        );
+        let mut twin = s.clone();
+        let id = r.spell_by_key("t:quicksand").unwrap();
+        let shape = r.spell(id).unwrap().magic.obstacle.clone().unwrap();
+        let hexes: Vec<Hex> = [(6, 5), (5, 5)]
+            .iter()
+            .map(|&(x, y)| at(&r, x, y))
+            .collect();
+        crate::obstacles::place(
+            &mut s,
+            (id, ObstacleKind::Pit, &shape),
+            BattleSide::Defender,
+            (&hexes, 0),
+            &mut Vec::new(),
+        );
+        for state in [&mut s, &mut twin] {
+            let st = &mut state.stacks.as_mut_slice()[1];
+            st.spells.status = st.spells.status.with(Status::BERSERK, true);
+        }
+        let told = |state: &mut BattleState| -> Vec<Event> {
+            let events = act(state, &r, Command::Defend).unwrap();
+            events
+                .iter()
+                .filter_map(|e| project(e, BattleSide::Attacker))
+                .collect()
+        };
+        let (a, b) = (told(&mut s), told(&mut twin));
+        std::eprintln!(
+            "{profile}: equal {}\n  with pits: {a:?}\n  without:   {b:?}",
+            a == b
+        );
+    }

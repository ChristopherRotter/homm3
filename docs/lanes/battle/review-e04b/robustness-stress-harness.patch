+//! THROWAWAY stress harness of the E04b robustness review (T11b). Not committed.
+//!
+//! Random battles on the synthetic ruleset with casting heroes of three tiers:
+//! 0 "derivable" (what a derived hero could have), 1 "extreme" (the full ranges of the seam's
+//! types, no single-precision patterns), 2 "hostile" (arbitrary `Rate::single` bit patterns).
+//! Every step: the chosen legal command (hero casts and creature casts included) must be accepted
+//! and the state's invariants must hold; at sampled steps every listed command is applied to a
+//! clone. Panics are caught per battle and reported with their seed.
+
+use std::collections::BTreeMap;
+use std::format;
+use std::num::NonZeroU32;
+use std::panic::{AssertUnwindSafe, catch_unwind};
+use std::println;
+use std::string::{String, ToString};
+use std::sync::Mutex;
+use std::time::Instant;
+use std::vec;
+use std::vec::Vec;
+
+use h3_content::{
+    Affects, CLONE_ON_ITS_ORIGINAL, CreatureFlag, CreatureSelector, CreatureStat, CreatureTypeId,
+    Formation, ObstacleKind, Ruleset, SchoolId, SpellCategory, SpellId, SpellScope,
+};
+use h3_contracts::{
+    Army, ArmyStack, BallistaControl, BattleEffect, BattleHero, BattleSetup, BattleSide,
+    DamageBonuses, EagleEye, FactionGroup, Obstacle, StatOp, TentControl,
+};
+use h3_kernel::Rng;
+
+use super::support::{CREATURES, Rate, hero, ruleset_with, try_ruleset_from};
+use crate::{
+    BattleState, CastTarget, CastTargets, Command, Event, Field, Hex, HexSet, LegalCommands,
+    NO_CORPSE, StackId, StackTraits, Viewer, apply, cast_targets, castable_spells,
+    creature_cast_targets, legal_commands, observe, observe_as, second_targets,
+};
+
+static LAST_PANIC: Mutex<Option<String>> = Mutex::new(None);
+
+fn env(name: &str, default: u64) -> u64 {
+    std::env::var(name)
+        .ok()
+        .and_then(|v| v.parse().ok())
+        .unwrap_or(default)
+}
+
+fn pick<T: Copy>(rng: &mut Rng, items: &[T]) -> T {
+    items[rng.below(items.len() as u32) as usize]
+}
+
+fn chance(rng: &mut Rng, percent: u32) -> bool {
+    rng.below(100) < percent
+}
+
+/// The profiles of the synthetic pack.
+pub(super) const PROFILES: &[&str] = &[
+    "t:faithful",
+    "t:quirky",
+    "t:single",
+    "t:original",
+    "t:unlimited",
+    "t:first",
+    "t:frenzy",
+    "t:counterstrike",
+    "t:fireshield",
+    "t:early",
+    "t:hypnosis",
+    "t:sight",
+    "t:pits",
+    "t:anchors",
+    "t:draws",
+    "t:sacrifice",
+    "t:mirrored",
+    "t:clone_on_original",
+    "t:first_stack",
+];
+
+/// The test ruleset with `profile`; `lively`: frequent morale and luck; the side stack limit.
+pub(super) fn stress_ruleset(profile: &str, lively: bool, limit: u8) -> Ruleset {
+    ruleset_with(profile, |b| {
+        if lively {
+            b.morale_dice = 4;
+            b.good_morale_chances = vec![1, 2, 3];
+            b.bad_morale_chances = vec![1, 2, 3];
+            b.luck_dice = 4;
+            b.good_luck_chances = vec![1, 2, 3];
+        }
+        b.side_stack_limit = limit;
+    })
+}
+
+fn bp(rng: &mut Rng, tier: u8) -> u32 {
+    if tier == 0 {
+        pick(rng, &[0, 500, 1000, 1500, 2500, 5000, 10_000, 20_000])
+    } else {
+        match rng.below(9) {
+            0 => 0,
+            1 => 1,
+            2 => 500,
+            3 => 10_000,
+            4 => 65_535,
+            5 => 1_000_000,
+            6 => u32::MAX,
+            7 => rng.next_u32(),
+            _ => rng.below(100_000),
+        }
+    }
+}
+
+fn single(rng: &mut Rng, tier: u8) -> Option<NonZeroU32> {
+    if tier < 2 {
+        return None;
+    }
+    let bits = match rng.below(7) {
+        0 | 1 => return None,
+        2 => rng.next_u32(),
+        3 => pick(
+            rng,
+            &[
+                0x7f80_0000,
+                0x7fc0_0000,
+                0xff80_0000,
+                0x8000_0001,
+                0x0000_0001,
+                0x5f7f_ffff,
+                0x6280_0000,
+                0x4b80_0000,
+                0x3f80_0000,
+                0x3d4c_cccd,
+                0x7f7f_ffff,
+                0x0080_0000,
+                0x4580_0000,
+            ],
+        ),
+        4 => rng.next_u32() & 0x7fff_ffff,
+        // Moderate values: 2^-8 .. 2^17.
+        _ => 0x3b80_0000 + rng.below(0x0c80_0000),
+    };
+    NonZeroU32::new(bits)
+}
+
+fn rate(rng: &mut Rng, tier: u8) -> Rate {
+    Rate {
+        bp: bp(rng, tier),
+        single: single(rng, tier),
+    }
+}
+
+/// A `SpellDamage` rate of the scopes that multiply (every spell, a school): with `STRESS_SAFE`
+/// small, so that the known overflow of `magic::spell_damage` (F-robust-3) does not end the
+/// battles early.
+fn damage_rate(rng: &mut Rng, tier: u8) -> Rate {
+    if env("STRESS_SAFE", 0) != 0 {
+        Rate::bp(pick(rng, &[0, 500, 5000, 20_000, 65_535]))
+    } else {
+        rate(rng, tier)
+    }
+}
+
+/// A rate of at most 1 (the damage reduction, Eagle Eye's chance).
+fn unit_rate(rng: &mut Rng, tier: u8) -> Rate {
+    let single = if tier < 2 || chance(rng, 60) {
+        None
+    } else {
+        // Positive patterns up to 1.0.
+        NonZeroU32::new(rng.below(0x3f80_0001))
+    };
+    Rate {
+        bp: pick(rng, &[0, 1, 500, 2500, 5000, 9999, 10_000]),
+        single,
+    }
+}
+
+fn all_spells(r: &Ruleset) -> Vec<SpellId> {
+    (0..r.spells().len())
+        .filter_map(SpellId::from_index)
+        .collect()
+}
+
+fn creature_pool(r: &Ruleset) -> Vec<CreatureTypeId> {
+    CREATURES
+        .iter()
+        .filter(|c| !c.7.contains(&"war_machine"))
+        .map(|c| r.creature_by_key(&format!("t:{}", c.0)).unwrap())
+        .collect()
+}
+
+fn selector(
+    r: &Ruleset,
+    rng: &mut Rng,
+    pool: &[CreatureTypeId],
+) -> CreatureSelector<CreatureTypeId> {
+    let _ = r;
+    match rng.below(3) {
+        0 => CreatureSelector::All,
+        1 => CreatureSelector::Flag(pick(
+            rng,
+            &[
+                CreatureFlag::Alive,
+                CreatureFlag::Shooter,
+                CreatureFlag::Undead,
+                CreatureFlag::Flying,
+            ],
+        )),
+        _ => CreatureSelector::Creature(pick(rng, pool)),
+    }
+}
+
+/// The valid opening spells of `r`: `(spell, mastery)` pairs the battle opens with.
+fn openings(r: &Ruleset) -> Vec<(SpellId, u8)> {
+    let mut out = Vec::new();
+    for id in all_spells(r) {
+        let spell = r.spell(id).unwrap();
+        for mastery in 0..=3 {
+            if crate::magic::opens_with(r, spell, mastery) {
+                out.push((id, mastery));
+            }
+        }
+    }
+    out
+}
+
+fn effects(r: &Ruleset, rng: &mut Rng, tier: u8, pool: &[CreatureTypeId]) -> Vec<BattleEffect> {
+    let spells = all_spells(r);
+    let opening = openings(r);
+    let n = rng.below(if tier == 0 { 10 } else { 44 });
+    let mut out = Vec::new();
+    let mut own: Vec<SpellId> = Vec::new();
+    let mut opened = 0;
+    let mut durations = 0;
+    for _ in 0..n {
+        let mut own_spell = |rng: &mut Rng| {
+            if own.len() < crate::MAX_SPELL_BONUSES {
+                let s = pick(rng, &spells);
+                if !own.contains(&s) {
+                    own.push(s);
+                }
+                s
+            } else {
+                pick(rng, &own)
+            }
+        };
+        let level = |rng: &mut Rng| -> u8 {
+            if tier == 0 {
+                u8::try_from(rng.below(6)).unwrap()
+            } else {
+                pick(rng, &[0, 1, 2, 3, 4, 5, 6, 100, 255])
+            }
+        };
+        let e = match rng.below(22) {
+            0 | 1 => BattleEffect::SpellDamage {
+                scope: SpellScope::All,
+                rate: damage_rate(rng, tier),
+            },
+            2 | 3 => BattleEffect::SpellDamage {
+                scope: SpellScope::School(
+                    SchoolId::from_index(rng.below(r.spell_schools().len() as u32) as usize)
+                        .unwrap(),
+                ),
+                rate: damage_rate(rng, tier),
+            },
+            4 => BattleEffect::SpellDamage {
+                scope: SpellScope::Spell(own_spell(rng)),
+                rate: rate(rng, tier),
+            },
+            5 | 6 => BattleEffect::SpellSpecialty {
+                spell: own_spell(rng),
+                bp_per_level: if tier == 0 {
+                    pick(rng, &[300, 500])
+                } else {
+                    pick(rng, &[0, 1, 300, 500, 10_000, u16::MAX])
+                },
+                level: if tier == 0 {
+                    u8::try_from(1 + rng.below(40)).unwrap()
+                } else {
+                    pick(rng, &[0, 1, 5, 30, 74, 255])
+                },
+            },
+            7 | 8 => BattleEffect::MagicResistance {
+                rate: if tier == 0 {
+                    Rate::bp(pick(rng, &[500, 1000, 2000, 3000]))
+                } else {
+                    rate(rng, tier)
+                },
+            },
+            9 => {
+                // A derived hero has one such effect.
+                if tier == 0 && durations > 0 {
+                    continue;
+                }
+                durations += 1;
+                BattleEffect::SpellDuration {
+                    rounds: if tier == 0 {
+                        u8::try_from(1 + rng.below(6)).unwrap()
+                    } else {
+                        pick(rng, &[0, 1, 3, 56, 255])
+                    },
+                }
+            }
+            10 => {
+                if !chance(rng, 4) {
+                    continue;
+                }
+                BattleEffect::NoCasting
+            }
+            11 => {
+                if !chance(rng, 25) {
+                    continue;
+                }
+                BattleEffect::SpellLevelLimit {
+                    max_level: if tier == 0 { 2 } else { level(rng) },
+                }
+            }
+            12 => BattleEffect::SpellImmunity {
+                spell: pick(rng, &spells),
+            },
+            13 => {
+                if !chance(rng, 30) {
+                    continue;
+                }
+                BattleEffect::SpellLevelImmunity {
+                    max_level: if tier == 0 { 4 } else { level(rng) },
+                }
+            }
+            14 => BattleEffect::MindImmunity,
+            15 => BattleEffect::NegateImmunities,
+            16 | 17 => {
+                if opened >= crate::MAX_OPENING_SPELLS || opening.is_empty() {
+                    continue;
+                }
+                opened += 1;
+                let (spell, mastery) = pick(rng, &opening);
+                BattleEffect::OpeningSpell {
+                    spell,
+                    mastery,
+                    power: if tier == 0 {
+                        u16::try_from(1 + rng.below(20)).unwrap()
+                    } else {
+                        pick(rng, &[1, 2, 8, 255, 256, 30_000, u16::MAX])
+                    },
+                }
+            }
+            18 => BattleEffect::StackStat {
+                creatures: selector(r, rng, pool),
+                stat: pick(rng, &CreatureStat::ALL),
+                op: pick(
+                    rng,
+                    &[StatOp::Add, StatOp::PercentBp, StatOp::PercentBpDown],
+                ),
+                amount: if tier == 0 {
+                    i16::try_from(rng.below(7)).unwrap() - 2
+                } else {
+                    pick(rng, &[i16::MIN, -100, -1, 0, 1, 10, 1000, i16::MAX])
+                },
+            },
+            19 => match rng.below(3) {
+                0 => BattleEffect::Regeneration {
+                    creatures: selector(r, rng, pool),
+                    hit_points: pick(rng, &[1, 50, u16::MAX]),
+                },
+                1 => BattleEffect::NoRangePenalty {
+                    creatures: selector(r, rng, pool),
+                },
+                _ => BattleEffect::ShootWhenAdjacent {
+                    creatures: selector(r, rng, pool),
+                },
+            },
+            20 => {
+                let amount = if tier == 0 {
+                    i8::try_from(rng.below(5)).unwrap() - 2
+                } else {
+                    pick(rng, &[i8::MIN, -3, -1, 1, 3, i8::MAX])
+                };
+                let affects = pick(rng, &Affects::ALL);
+                match rng.below(4) {
+                    0 => BattleEffect::Morale { amount, affects },
+                    1 => BattleEffect::Luck { amount, affects },
+                    2 => BattleEffect::MoraleAtMost {
+                        value: amount,
+                        affects,
+                    },
+                    _ => BattleEffect::LuckAtMost {
+                        value: amount,
+                        affects,
+                    },
+                }
+            }
+            _ => {
+                if chance(rng, 80) {
+                    let n = r.factions().len() as u32;
+                    let ids: Vec<_> = (0..n)
+                        .filter(|_| chance(rng, 50))
+                        .filter_map(|i| h3_content::FactionId::from_index(i as usize))
+                        .collect();
+                    match FactionGroup::new(&ids) {
+                        Some(factions) => BattleEffect::AlignmentGroup { factions },
+                        None => continue,
+                    }
+                } else if chance(rng, 20) {
+                    BattleEffect::NoRetreat
+                } else {
+                    continue;
+                }
+            }
+        };
+        out.push(e);
+    }
+    out
+}
+
+/// A casting hero of `tier`.
+fn caster(r: &Ruleset, rng: &mut Rng, tier: u8, pool: &[CreatureTypeId]) -> BattleHero {
+    let mut h = hero(r);
+    let primary = |rng: &mut Rng| -> u8 {
+        if tier == 0 {
+            u8::try_from(rng.below(31)).unwrap()
+        } else {
+            pick(rng, &[0, 1, 2, 7, 30, 99, 150, 255])
+        }
+    };
+    h.attack = primary(rng);
+    h.defense = primary(rng);
+    h.power = primary(rng);
+    h.knowledge = primary(rng);
+    h.tactics = if chance(rng, 12) {
+        u8::try_from(rng.below(4)).unwrap()
+    } else {
+        0
+    };
+    h.damage = DamageBonuses {
+        ranged: rate(rng, tier),
+        melee: rate(rng, tier),
+        reduction: unit_rate(rng, tier),
+    };
+    if chance(rng, 40) {
+        h.war_machines.ballista = Some(BallistaControl {
+            shots: if tier == 0 {
+                u8::try_from(1 + rng.below(2)).unwrap()
+            } else {
+                pick(rng, &[1, 2, 3, 255])
+            },
+            double_damage_chance_bp: pick(rng, &[0, 5000, 10_000]),
+        });
+    }
+    if chance(rng, 40) {
+        h.war_machines.tent = Some(TentControl {
+            heal_bonus: rate(rng, tier),
+        });
+    }
+    h.surrender_discount_bp = pick(rng, &[0, 2000, 10_000]);
+    let spells = all_spells(r);
+    let hero_spells: Vec<SpellId> = spells
+        .iter()
+        .copied()
+        .filter(|&s| r.spell(s).unwrap().category != SpellCategory::Ability)
+        .collect();
+    // The book: usually every hero spell (adventure spells and spells without effects too).
+    if chance(rng, 96) {
+        let keep = if chance(rng, 80) { 100 } else { 60 };
+        h.magic.spell_book = Some(
+            hero_spells
+                .iter()
+                .copied()
+                .filter(|_| chance(rng, keep))
+                .collect(),
+        );
+    }
+    // Masteries of any spell (abilities too: the seam's list covers every spell).
+    let style = rng.below(6);
+    h.magic.masteries = spells
+        .iter()
+        .filter_map(|&s| {
+            let m = match style {
+                0 => 0,
+                1 => 1,
+                2 => 2,
+                3 => 3,
+                _ => u8::try_from(rng.below(4)).unwrap(),
+            };
+            (m > 0).then_some((s, m))
+        })
+        .collect();
+    h.magic.mana = if tier == 0 {
+        pick(rng, &[0, 4, 12, 40, 150, 500, 999])
+    } else {
+        pick(rng, &[0, 3, 20, 200, 5000, u16::MAX])
+    };
+    h.magic.max_mana = pick(rng, &[0, 10, 500, u16::MAX]);
+    if chance(rng, 30) {
+        h.magic.eagle_eye = Some(EagleEye {
+            chance: unit_rate(rng, tier),
+            spells: hero_spells
+                .iter()
+                .copied()
+                .filter(|_| chance(rng, 50))
+                .collect(),
+        });
+    }
+    h.effects = effects(r, rng, tier, pool);
+    h
+}
+
+fn count(rng: &mut Rng, tier: u8) -> u32 {
+    if tier == 0 {
+        match rng.below(10) {
+            0..=4 => 1 + rng.below(30),
+            5..=7 => 1 + rng.below(500),
+            _ => 1 + rng.below(20_000),
+        }
+    } else {
+        match rng.below(10) {
+            0..=3 => 1 + rng.below(100),
+            4..=5 => 60_000 + rng.below(140_000),
+            6..=7 => 1 + rng.below(u32::MAX),
+            8 => u32::MAX,
+            _ => 1 + rng.below(3),
+        }
+    }
+}
+
+fn army(
+    rng: &mut Rng,
+    tier: u8,
+    pool: &[CreatureTypeId],
+    focus: &[CreatureTypeId],
+    army_slots: u8,
+) -> Army {
+    let n = 1 + rng.below(u32::from(army_slots));
+    let mut slots: Vec<u8> = (0..army_slots).collect();
+    let mut stacks = Vec::new();
+    for _ in 0..n {
+        let slot = slots.remove(rng.below(slots.len() as u32) as usize);
+        let creature = if !focus.is_empty() && chance(rng, 45) {
+            pick(rng, focus)
+        } else {
+            pick(rng, pool)
+        };
+        stacks.push(ArmyStack {
+            slot,
+            creature,
+            count: count(rng, tier),
+        });
+    }
+    Army { stacks }
+}
+
+/// The creatures with magic of their own (casters, raisers, the mana creatures, the defences,
+/// rebirth, fear, the strike's spells).
+fn magic_creatures(r: &Ruleset) -> Vec<CreatureTypeId> {
+    CREATURES
+        .iter()
+        .filter(|c| !c.7.contains(&"war_machine"))
+        .filter(|c| {
+            c.7.iter().any(|t| {
+                [
+                    "spell_caster",
+                    "random_spell_caster",
+                    "helpful_spell_caster",
+                    "periodic_spell_caster",
+                    "stack_raiser",
+                    "corpse_raiser",
+                    "spell_after_strike",
+                    "spell_damage_after_strike",
+                    "damage_after_strike",
+                    "innate_spell",
+                    "rebirth",
+                    "fear",
+                    "mana_",
+                    "spell_cost",
+                    "magic_resistance",
+                    "spell_level_immunity",
+                    "spell_damage_reduction",
+                    "school_immunity",
+                    "spell_immunity",
+                    "absolute_immunity",
+                    "mind_immune",
+                    "life_drain",
+                    "regeneration",
+                ]
+                .iter()
+                .any(|p| t.starts_with(p))
+            })
+        })
+        .map(|c| r.creature_by_key(&format!("t:{}", c.0)).unwrap())
+        .collect()
+}
+
+pub(super) fn setup(r: &Ruleset, rng: &mut Rng, tier: u8) -> BattleSetup {
+    let pool = creature_pool(r);
+    let focus = magic_creatures(r);
+    let machines = |rng: &mut Rng| -> Vec<CreatureTypeId> {
+        let mut out = Vec::new();
+        if chance(rng, 35) {
+            let key = if chance(rng, 80) {
+                "t:ballista"
+            } else {
+                "t:firebomb"
+            };
+            out.push(r.creature_by_key(key).unwrap());
+        }
+        if chance(rng, 30) {
+            out.push(r.creature_by_key("t:cart").unwrap());
+        }
+        if chance(rng, 30) {
+            out.push(r.creature_by_key("t:tent").unwrap());
+        }
+        out
+    };
+    let mut obstacles = Vec::new();
+    let mut used = HexSet::new();
+    let mut wanted: Vec<u8> = Vec::new();
+    // Sometimes a pair: an obstacle anchored on itself and its right neighbour anchored on it.
+    // The standard field (17 x 11, one side column) draws what the first version of this harness
+    // drew, so that its seeds reproduce.
+    let f = r.battle().field;
+    let (w, rows, side) = (
+        u32::from(f.width),
+        u32::from(f.height),
+        u32::from(f.side_columns),
+    );
+    let hexes = w * rows;
+    if chance(rng, 35) {
+        let h = side + 1 + rng.below(w.saturating_sub(5)) + w * rng.below(rows);
+        let h = h - h % 3 + 1;
+        wanted.extend([h, h + 1].map(|h| u8::try_from(h.min(254)).unwrap()));
+    }
+    for _ in 0..rng.below(7) {
+        let h = side + 1 + rng.below(w.saturating_sub(4)) + w * rng.below(rows);
+        wanted.push(u8::try_from(h.min(254)).unwrap());
+    }
+    for h in wanted {
+        let x = u32::from(h) % w;
+        if used.contains(Hex(h))
+            || u32::from(h) >= hexes
+            || !(side + 1..=w.saturating_sub(2 + side)).contains(&x)
+        {
+            continue;
+        }
+        used.insert(Hex(h));
+        obstacles.push(Obstacle {
+            hexes: vec![h],
+            anchor: [None, Some(h), Some(h - 1)][usize::from(h % 3)],
+        });
+    }
+    let heroes = [
+        chance(rng, 92).then(|| caster(r, rng, tier, &pool)),
+        chance(rng, 85).then(|| caster(r, rng, tier, &pool)),
+    ];
+    BattleSetup {
+        attacker: army(rng, tier, &pool, &focus, r.battle().army_slots),
+        defender: army(rng, tier, &pool, &focus, r.battle().army_slots),
+        obstacles,
+        heroes,
+        terrain: match rng.below(5) {
+            0 => r.terrain_by_key("t:plain"),
+            1 => r.terrain_by_key("t:lava"),
+            _ => None,
+        },
+        war_machines: [machines(rng), machines(rng)],
+        formations: [
+            pick(rng, &[Formation::Loose, Formation::Tight]),
+            pick(rng, &[Formation::Loose, Formation::Tight]),
+        ],
+        funds: [rng.next_u32(), pick(rng, &[0, 1000, u32::MAX])],
+    }
+}
+
+macro_rules! ensure {
+    ($cond:expr, $($arg:tt)*) => {
+        if !$cond {
+            return Err(format!($($arg)*));
+        }
+    };
+}
+
+/// The state's invariants (those of `every_step_preserves_the_invariants` and some more).
+pub(super) fn check_state(
+    state: &BattleState,
+    r: &Ruleset,
+    initial: [usize; 2],
+    deep: bool,
+) -> Result<(), String> {
+    let field = Field::new(r.battle().field);
+    let stacks = state.stacks();
+    let effects = state.effects();
+    for w in effects.windows(2) {
+        ensure!(
+            (w[0].stack, w[0].spell) < (w[1].stack, w[1].spell),
+            "effects not sorted or not unique: {:?} {:?}",
+            w[0],
+            w[1]
+        );
+    }
+    for e in effects {
+        ensure!(e.stack.index() < stacks.len(), "effect on no stack: {e:?}");
+        ensure!(
+            stacks[e.stack.index()].is_alive(),
+            "effect on a dead stack: {e:?}"
+        );
+        ensure!(e.rounds != Some(0), "effect with 0 rounds: {e:?}");
+        ensure!(
+            r.spell(e.spell).is_some_and(|s| s.magic.is_timed()),
+            "effect of a spell that is not timed: {e:?}"
+        );
+    }
+    ensure!(
+        state.is_over() == state.active().is_none(),
+        "over {} but active {:?}",
+        state.is_over(),
+        state.active()
+    );
+    if let Some(a) = state.active() {
+        ensure!(
+            stacks.get(a.index()).is_some_and(|s| s.is_alive()),
+            "the active stack {a:?} is dead or missing"
+        );
+    }
+    let walls = state
+        .spell_obstacles()
+        .iter()
+        .filter(|o| o.kind == ObstacleKind::Wall)
+        .fold(HexSet::new(), |set, o| set.union(o.hexes));
+    let mut taken = HexSet::new();
+    let turned = r.quirks().is_enabled(CLONE_ON_ITS_ORIGINAL);
+    let good = i8::try_from(r.battle().good_morale.levels()).unwrap();
+    let bad = i8::try_from(r.battle().bad_morale.levels()).unwrap();
+    let lucky = i8::try_from(r.battle().good_luck.levels()).unwrap();
+    for (i, s) in stacks.iter().enumerate() {
+        let id = StackId(u8::try_from(i).unwrap());
+        ensure!(
+            s.max_hp >= 1,
+            "stack {i} has no hit points per creature: {s:?}"
+        );
+        ensure!(r.creature(s.creature).is_some(), "stack {i}: no creature");
+        ensure!(
+            s.count <= s.base_count,
+            "stack {i}: count {} above its base {}",
+            s.count,
+            s.base_count
+        );
+        ensure!(
+            state.temporary(id) <= s.base_count,
+            "stack {i}: temporary {} above its base {}",
+            state.temporary(id),
+            s.base_count
+        );
+        if s.is_alive() {
+            ensure!(
+                (1..=s.max_hp).contains(&s.top_hp),
+                "stack {i}: top hp {} of {}",
+                s.top_hp,
+                s.max_hp
+            );
+            let Some(fp) = field.footprint(s.hex, s.is_two_hex(), s.side) else {
+                return Err(format!("stack {i} is off the field: {s:?}"));
+            };
+            for h in fp.hexes() {
+                ensure!(!taken.contains(h), "two living stacks on {h:?} (stack {i})");
+                taken.insert(h);
+                ensure!(
+                    !state.obstacles().contains(h),
+                    "stack {i} stands on a natural obstacle at {h:?}"
+                );
+                ensure!(!walls.contains(h), "stack {i} stands in a wall at {h:?}");
+                ensure!(
+                    field.is_standable(h) || s.has(StackTraits::WAR_MACHINE),
+                    "stack {i} stands on the side column hex {h:?}"
+                );
+            }
+            ensure!(
+                state.corpse(id) == 0,
+                "the living stack {i} has corpse {}",
+                state.corpse(id)
+            );
+        } else {
+            ensure!(s.top_hp == 0, "the dead stack {i} has top hp {}", s.top_hp);
+            ensure!(
+                !s.is_created() || state.corpse(id) == NO_CORPSE,
+                "the dead created stack {i} left a corpse"
+            );
+            ensure!(
+                state.is_over() || state.corpse(id) != 0,
+                "the dead stack {i} has no corpse mark after the command"
+            );
+        }
+        let clone = s.is_alive() && s.has(StackTraits::CLONE);
+        if turned {
+            ensure!(
+                !clone || state.clone_rounds(id) > 0,
+                "clone {i} without rounds"
+            );
+        } else {
+            ensure!(
+                clone == (state.clone_rounds(id) > 0),
+                "stack {i}: clone {clone} but rounds {}",
+                state.clone_rounds(id)
+            );
+        }
+        ensure!(
+            (-bad..=good).contains(&s.morale) && (0..=lucky).contains(&s.luck),
+            "stack {i}: morale {} luck {}",
+            s.morale,
+            s.luck
+        );
+        ensure!(
+            s.retaliations_left <= s.retaliations.max(s.retaliations_left),
+            "retaliations"
+        );
+    }
+    for side in BattleSide::BOTH {
+        let n = stacks.iter().filter(|s| s.side == side).count();
+        let limit = usize::from(r.battle().side_stack_limit).max(initial[side.index()]);
+        ensure!(n <= limit, "{side:?} has {n} stacks, limit {limit}");
+    }
+    // The observations build, for both sides and a spectator; their links are consistent.
+    let obs = observe(state, r, BattleSide::Attacker);
+    let _ = observe(state, r, BattleSide::Defender);
+    let _ = observe_as(state, r, Viewer::Spectator);
+    for (i, link) in obs.clone_links.iter().enumerate() {
+        if let Some(l) = link {
+            ensure!(
+                l.index() < stacks.len(),
+                "stack {i}: link to no stack {l:?}"
+            );
+            ensure!(
+                obs.clone_links[l.index()] == Some(StackId(u8::try_from(i).unwrap())),
+                "stack {i}: its link {l:?} does not link back"
+            );
+        }
+    }
+    for (i, &binders) in obs.binders.iter().enumerate() {
+        if binders == 0 {
+            continue;
+        }
+        ensure!(
+            i < stacks.len() && stacks[i].is_alive(),
+            "binders on the dead or missing stack {i}"
+        );
+        for b in 0..64 {
+            if binders & (1 << b) != 0 {
+                ensure!(
+                    stacks.get(b).is_some_and(|s| s.is_alive()),
+                    "stack {i} is bound by the dead or missing stack {b}"
+                );
+            }
+        }
+    }
+    if deep {
+        for i in 0..stacks.len() {
+            if !stacks[i].is_alive() {
+                continue;
+            }
+            let mut fresh = state.clone();
+            crate::effects::recompute(&mut fresh, r, StackId(u8::try_from(i).unwrap()));
+            ensure!(
+                fresh.stacks()[i] == stacks[i],
+                "stack {i} is not what its effects make of it:\n  is     {:?}\n  should {:?}",
+                stacks[i],
+                fresh.stacks()[i]
+            );
+        }
+    }
+    Ok(())
+}
+
+/// Every command `side` may issue now: the legal commands, the hero's casts and the active
+/// stack's casts.
+pub(super) fn listed(
+    state: &BattleState,
+    r: &Ruleset,
+    side: BattleSide,
+) -> Result<Vec<Command>, String> {
+    let mut legal = LegalCommands::new();
+    legal_commands(state, r, side, &mut legal);
+    let mut out: Vec<Command> = legal.iter().copied().collect();
+    let mut targets = CastTargets::new();
+    let mut seconds = CastTargets::new();
+    for spell in castable_spells(state, r, side).iter() {
+        cast_targets(state, r, side, spell, &mut targets);
+        ensure!(!targets.is_empty(), "castable {spell:?} without a target");
+        for &target in targets.iter() {
+            second_targets(state, r, side, (spell, target), &mut seconds);
+            ensure!(
+                !seconds.is_empty(),
+                "{spell:?} at {target:?} without a second target"
+            );
+            for &second in seconds.iter() {
+                out.push(Command::Cast {
+                    spell,
+                    target,
+                    second,
+                });
+            }
+        }
+    }
+    creature_cast_targets(state, r, side, &mut targets);
+    for &target in targets.iter() {
+        out.push(Command::CreatureCast { target });
+    }
+    Ok(out)
+}
+
+#[derive(Debug, Default, Clone)]
+pub(super) struct Stats {
+    pub battles: u64,
+    pub steps: u64,
+    pub finished: u64,
+    pub unfinished: u64,
+    pub stuck: u64,
+    pub refused: u64,
+    pub hero_casts: u64,
+    pub creature_casts: u64,
+    pub exhaustive: u64,
+    pub probed: u64,
+    pub arbitrary: u64,
+    pub max_events: usize,
+    pub max_events_at: (u64, u64),
+    pub max_micros: u128,
+    pub max_micros_at: (u64, u64),
+    pub max_round: u16,
+    pub max_rounds_step: u16,
+    pub max_rounds_step_at: (u64, u64),
+    pub max_effects: usize,
+    pub max_obstacles: usize,
+    pub events: BTreeMap<String, u64>,
+    pub casts: BTreeMap<String, u64>,
+}
+
+#[derive(Debug, Clone, Copy)]
+pub(super) struct Opts {
+    pub steps: u64,
+    pub hero_cast: u32,
+    pub creature_cast: u32,
+    pub exhaustive_every: u32,
+    pub deep_every: u32,
+    pub count_events: bool,
+    pub trace: bool,
+}
+
+fn event_name(e: &Event) -> String {
+    let s = format!("{:?}", e.kind);
+    s.split(|c: char| !c.is_alphanumeric())
+        .next()
+        .unwrap_or("")
+        .to_string()
+}
+
+/// An arbitrary (usually invalid) command.
+fn arbitrary(rng: &mut Rng, r: &Ruleset) -> Command {
+    let target = |rng: &mut Rng| match rng.below(3) {
+        0 => CastTarget::None,
+        1 => CastTarget::Stack(StackId(u8::try_from(rng.below(48)).unwrap())),
+        _ => CastTarget::Hex(Hex(u8::try_from(rng.below(256)).unwrap())),
+    };
+    match rng.below(9) {
+        0 => Command::Wait,
+        1 => Command::EndTactics,
+        2 => Command::Move {
+            to: Hex(u8::try_from(rng.below(256)).unwrap()),
+        },
+        3 => Command::Attack {
+            target: StackId(u8::try_from(rng.below(48)).unwrap()),
+            from: Hex(u8::try_from(rng.below(256)).unwrap()),
+        },
+        4 => Command::Shoot {
+            target: StackId(u8::try_from(rng.below(48)).unwrap()),
+            at: Hex(u8::try_from(rng.below(256)).unwrap()),
+        },
+        5 => Command::Heal {
+            target: StackId(u8::try_from(rng.below(48)).unwrap()),
+        },
+        6 | 7 => Command::Cast {
+            spell: SpellId::from_raw(
+                u16::try_from(rng.below(r.spells().len() as u32 + 3)).unwrap(),
+            ),
+            target: target(rng),
+            second: target(rng),
+        },
+        _ => Command::CreatureCast {
+            target: target(rng),
+        },
+    }
+}
+
+/// Plays one battle; `Err` describes the first failure that is not a panic.
+pub(super) fn play_one(
+    r: &Ruleset,
+    setup: &BattleSetup,
+    seed: u64,
+    opts: &Opts,
+    stats: &mut Stats,
+) -> Result<(), String> {
+    let mut state = match BattleState::new(r, setup, seed) {
+        Ok(s) => s,
+        Err(e) => {
+            stats.refused += 1;
+            return Err(format!("setup refused: {e:?}"));
+        }
+    };
+    let initial =
+        BattleSide::BOTH.map(|side| state.stacks().iter().filter(|s| s.side == side).count());
+    check_state(&state, r, initial, true).map_err(|e| format!("at the start: {e}"))?;
+    let mut agent = Rng::for_stream(seed, h3_kernel::StreamId::AGENT);
+    let mut legal = LegalCommands::new();
+    let mut targets = CastTargets::new();
+    let mut seconds = CastTargets::new();
+    let mut events: Vec<Event> = Vec::new();
+    let mut step = 0u64;
+    let total = opts.steps + env("STRESS_CLOSING", opts.steps / 2);
+    while let Some(side) = state.side_to_act() {
+        if step >= total {
+            break;
+        }
+        // After the bound the agents only fight, so that a battle that can end does.
+        let closing = step >= opts.steps;
+        step += 1;
+        let round = state.round();
+        let ctx = |what: &str| format!("step {step} (round {round}): {what}");
+        // The other side has nothing to do.
+        let other = side.opponent();
+        legal_commands(&state, r, other, &mut legal);
+        ensure!(
+            legal.is_empty(),
+            "{}",
+            ctx("the other side has legal commands")
+        );
+        ensure!(
+            castable_spells(&state, r, other).is_empty(),
+            "{}",
+            ctx("the other side may cast")
+        );
+        creature_cast_targets(&state, r, other, &mut targets);
+        ensure!(
+            targets.is_empty(),
+            "{}",
+            ctx("the other side's stack may cast")
+        );
+
+        if opts.exhaustive_every > 0 && agent.below(opts.exhaustive_every) == 0 {
+            stats.exhaustive += 1;
+            let all = listed(&state, r, side).map_err(|e| ctx(&e))?;
+            for c in &all {
+                let mut probe = state.clone();
+                let res = catch_unwind(AssertUnwindSafe(|| {
+                    apply(&mut probe, r, side, *c, &mut crate::NoopSink)
+                }));
+                match res {
+                    Err(_) => {
+                        let msg = LAST_PANIC.lock().unwrap().take().unwrap_or_default();
+                        return Err(ctx(&format!("PANIC in the probe of {c:?}: {msg}")));
+                    }
+                    Ok(Err(e)) => {
+                        return Err(ctx(&format!("listed {c:?} rejected: {e:?}")));
+                    }
+                    Ok(Ok(())) => {}
+                }
+                stats.probed += 1;
+                check_state(&probe, r, initial, false)
+                    .map_err(|e| ctx(&format!("after the probe of {c:?}: {e}")))?;
+            }
+            // Arbitrary commands: a rejection changes nothing; an accepted one was listed.
+            for _ in 0..12 {
+                let c = arbitrary(&mut agent, r);
+                let actor = if agent.below(8) == 0 { other } else { side };
+                let mut probe = state.clone();
+                stats.arbitrary += 1;
+                match apply(&mut probe, r, actor, c, &mut crate::NoopSink) {
+                    Err(_) => ensure!(
+                        probe == state && probe.state_hash() == state.state_hash(),
+                        "{}",
+                        ctx(&format!("the rejected {c:?} changed the state"))
+                    ),
+                    Ok(()) => ensure!(
+                        actor == side && all.contains(&c),
+                        "{}",
+                        ctx(&format!("the unlisted {c:?} was accepted for {actor:?}"))
+                    ),
+                }
+            }
+        }
+
+        legal_commands(&state, r, side, &mut legal);
+        ensure!(!legal.is_empty(), "{}", ctx("no legal command"));
+        let spells: Vec<SpellId> = castable_spells(&state, r, side).iter().collect();
+        creature_cast_targets(&state, r, side, &mut targets);
+        let roll = agent.below(100);
+        let cmd = if !closing && !spells.is_empty() && roll < opts.hero_cast {
+            let spell = pick(&mut agent, &spells);
+            cast_targets(&state, r, side, spell, &mut targets);
+            ensure!(
+                !targets.is_empty(),
+                "{}",
+                ctx(&format!("castable {spell:?} without a target"))
+            );
+            let target = targets.as_slice()[agent.below(targets.len() as u32) as usize];
+            second_targets(&state, r, side, (spell, target), &mut seconds);
+            ensure!(
+                !seconds.is_empty(),
+                "{}",
+                ctx(&format!("{spell:?} at {target:?} without a second target"))
+            );
+            let second = seconds.as_slice()[agent.below(seconds.len() as u32) as usize];
+            stats.hero_casts += 1;
+            if opts.count_events {
+                let key = r.spell(spell).unwrap().key.as_str().to_string();
+                *stats.casts.entry(key).or_default() += 1;
+            }
+            Command::Cast {
+                spell,
+                target,
+                second,
+            }
+        } else if !closing && !targets.is_empty() && roll < opts.hero_cast + opts.creature_cast {
+            stats.creature_casts += 1;
+            Command::CreatureCast {
+                target: targets.as_slice()[agent.below(targets.len() as u32) as usize],
+            }
+        } else {
+            let staying: Vec<Command> = legal
+                .iter()
+                .copied()
+                .filter(|c| !c.leaves_battle())
+                .collect();
+            let strikes: Vec<Command> = staying
+                .iter()
+                .copied()
+                .filter(|c| matches!(c, Command::Attack { .. } | Command::Shoot { .. }))
+                .collect();
+            if !closing && agent.below(1000) < 2 {
+                legal.as_slice()[agent.below(legal.len() as u32) as usize]
+            } else if !strikes.is_empty() && (closing || agent.below(100) < 45) {
+                pick(&mut agent, &strikes)
+            } else {
+                pick(&mut agent, &staying)
+            }
+        };
+        if opts.trace {
+            println!("    step {step} round {} {side:?}: {cmd:?}", state.round());
+        }
+        events.clear();
+        let t0 = Instant::now();
+        let res = apply(&mut state, r, side, cmd, &mut events);
+        let micros = t0.elapsed().as_micros();
+        if let Err(e) = res {
+            return Err(ctx(&format!("legal {cmd:?} rejected: {e:?}")));
+        }
+        stats.steps += 1;
+        if micros > stats.max_micros {
+            stats.max_micros = micros;
+            stats.max_micros_at = (seed, step);
+        }
+        if events.len() > stats.max_events {
+            stats.max_events = events.len();
+            stats.max_events_at = (seed, step);
+        }
+        stats.max_round = stats.max_round.max(state.round());
+        let advanced = state.round().saturating_sub(round);
+        if advanced > stats.max_rounds_step {
+            stats.max_rounds_step = advanced;
+            stats.max_rounds_step_at = (seed, step);
+        }
+        stats.max_effects = stats.max_effects.max(state.effects().len());
+        stats.max_obstacles = stats.max_obstacles.max(state.spell_obstacles().len());
+        if opts.count_events {
+            for e in &events {
+                *stats.events.entry(event_name(e)).or_default() += 1;
+            }
+        }
+        if opts.trace {
+            for e in &events {
+                println!("        {:?}", e.kind);
+            }
+        }
+        let deep = opts.deep_every > 0 && agent.below(opts.deep_every) == 0;
+        check_state(&state, r, initial, deep)
+            .map_err(|e| format!("step {step}: after {cmd:?}: {e}"))?;
+    }
+    if state.is_over() {
+        stats.finished += 1;
+        let o = state.outcome().ok_or("over without an outcome")?;
+        for side in BattleSide::BOTH {
+            let n = state.stacks().iter().filter(|s| s.side == side).count();
+            ensure!(
+                o.stacks[side.index()].len() == n,
+                "the outcome lists {} of {n} stacks",
+                o.stacks[side.index()].len()
+            );
+            for rec in &o.stacks[side.index()] {
+                ensure!(
+                    rec.end <= rec.start,
+                    "the outcome ends above its start: {rec:?}"
+                );
+            }
+            // One survivor per army slot, in slot order (the outcome's debug assertion).
+            let survivors = &o.survivors[side.index()].stacks;
+            ensure!(
+                survivors.windows(2).all(|w| w[0].slot < w[1].slot),
+                "survivors not one per slot in slot order: {survivors:?}"
+            );
+            ensure!(
+                survivors.iter().all(|s| s.count > 0),
+                "a survivor without creatures: {survivors:?}"
+            );
+        }
+    } else {
+        ensure!(state.outcome().is_none(), "an outcome before the end");
+        stats.unfinished += 1;
+        if step >= total {
+            stats.stuck += 1;
+            if stats.stuck <= env("STRESS_STUCK", 0) {
+                println!(
+                    "  not over after {step} steps, seed {seed}, round {}:",
+                    state.round()
+                );
+                for (i, s) in state.stacks().iter().enumerate() {
+                    if s.is_alive() {
+                        let key = r.creature_key(s.creature).map_or("?", |k| k.as_str());
+                        println!(
+                            "    {i} {:?} {key} x{} (of {}) hp {}/{} speed {} at {:?} status {:#b} flags {:#b} casts {} effects {}",
+                            s.side,
+                            s.count,
+                            s.base_count,
+                            s.top_hp,
+                            s.max_hp,
+                            s.speed_now(),
+                            s.hex,
+                            s.spells.status.bits(),
+                            s.flags.bits(),
+                            state.casts_left(StackId(u8::try_from(i).unwrap())),
+                            state
+                                .effects()
+                                .iter()
+                                .filter(|e| e.stack.index() == i)
+                                .count(),
+                        );
+                    }
+                }
+                println!(
+                    "    heroes {:?}; obstacles {}",
+                    BattleSide::BOTH.map(|side| state.hero(side).map(|h| (h.power, h.mana))),
+                    state.spell_obstacles().len()
+                );
+            }
+        }
+    }
+    Ok(())
+}
+
+/// Runs `games` battles of `tier` from seed `first` on the rulesets of `profiles`, catching
+/// panics. Returns the failures as `(key, description)`.
+pub(super) fn run(
+    profiles: &[&str],
+    tier: u8,
+    first: u64,
+    games: u64,
+    opts: &Opts,
+) -> (Stats, Vec<(u64, String)>) {
+    std::panic::set_hook(std::boxed::Box::new(|info| {
+        *LAST_PANIC.lock().unwrap() = Some(format!("{info}"));
+    }));
+    let mut rulesets = Vec::new();
+    for p in profiles {
+        for (lively, limit) in [(true, 12), (false, 20), (true, 21)] {
+            rulesets.push((
+                p.to_string(),
+                lively,
+                limit,
+                stress_ruleset(p, lively, limit),
+            ));
+        }
+    }
+    let mut stats = Stats::default();
+    let mut failures: Vec<(u64, String)> = Vec::new();
+    let started = Instant::now();
+    for seed in first..first + games {
+        let (profile, lively, limit, r) = &rulesets[(seed % rulesets.len() as u64) as usize];
+        let mut rng = Rng::from_seed(seed ^ 0x5eed_0000_0000_0000 ^ (u64::from(tier) << 40));
+        let setup = setup(r, &mut rng, tier);
+        stats.battles += 1;
+        let mut local = stats.clone();
+        let res = catch_unwind(AssertUnwindSafe(|| {
+            play_one(r, &setup, seed, opts, &mut local)
+        }));
+        let label =
+            format!("tier {tier} seed {seed} profile {profile} lively {lively} limit {limit}");
+        match res {
+            Ok(Ok(())) => stats = local,
+            Ok(Err(e)) => {
+                stats = local;
+                if !e.starts_with("setup refused") || failures.len() < 50 {
+                    failures.push((seed, format!("{label}: {e}")));
+                }
+            }
+            Err(_) => {
+                let msg = LAST_PANIC.lock().unwrap().take().unwrap_or_default();
+                failures.push((seed, format!("{label}: PANIC {msg}")));
+            }
+        }
+        if (seed - first + 1) % 500 == 0 {
+            println!(
+                "[{:>7.1}s] {} battles, {} steps, {} failures, finished {}, hero casts {}, creature casts {}",
+                started.elapsed().as_secs_f64(),
+                stats.battles,
+                stats.steps,
+                failures.len(),
+                stats.finished,
+                stats.hero_casts,
+                stats.creature_casts
+            );
+        }
+    }
+    let _ = std::panic::take_hook();
+    (stats, failures)
+}
+
+fn report(stats: &Stats, failures: &[(u64, String)]) {
+    println!(
+        "battles {} steps {} finished {} unfinished {} (at the bound {}) refused {}",
+        stats.battles, stats.steps, stats.finished, stats.unfinished, stats.stuck, stats.refused
+    );
+    println!(
+        "hero casts {} creature casts {} exhaustive steps {} probes {} arbitrary {}",
+        stats.hero_casts, stats.creature_casts, stats.exhaustive, stats.probed, stats.arbitrary
+    );
+    println!(
+        "max events per command {} at {:?}; slowest apply {} us at {:?}; max round {}; most rounds in one command {} at {:?}; max effects {}; max spell obstacles {}",
+        stats.max_events,
+        stats.max_events_at,
+        stats.max_micros,
+        stats.max_micros_at,
+        stats.max_round,
+        stats.max_rounds_step,
+        stats.max_rounds_step_at,
+        stats.max_effects,
+        stats.max_obstacles
+    );
+    if !stats.events.is_empty() {
+        println!("events: {:?}", stats.events);
+        println!("casts: {:?}", stats.casts);
+    }
+    // Group the failures by their message without the numbers.
+    let mut groups: BTreeMap<String, (u64, String)> = BTreeMap::new();
+    for (_, f) in failures {
+        let tail = f.split_once(": ").map_or(f.as_str(), |x| x.1);
+        let key: String = tail
+            .chars()
+            .filter(|c| !c.is_ascii_digit())
+            .take(160)
+            .collect();
+        let entry = groups.entry(key).or_insert((0, f.clone()));
+        entry.0 += 1;
+    }
+    println!("{} failures in {} groups", failures.len(), groups.len());
+    for (n, first) in groups.values() {
+        println!("  x{n}: {first}");
+    }
+}

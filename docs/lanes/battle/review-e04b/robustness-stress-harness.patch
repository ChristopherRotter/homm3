+/// The battle at its stack capacity: both sides summon until neither may (21 stacks each with the
+/// largest side stack limit), then play on with every listed command probed.
+#[test]
+#[ignore = "throwaway stress run"]
+fn stress_capacity() {
+    let games = env("STRESS_GAMES", 50);
+    let first = env("STRESS_SEED", 1);
+    let mut reached = 0;
+    let mut most = 0;
+    for seed in first..first + games {
+        let profile = PROFILES[(seed % PROFILES.len() as u64) as usize];
+        let r = stress_ruleset(profile, seed % 2 == 0, 21);
+        let mut rng = Rng::from_seed(seed);
+        let pool = creature_pool(&r);
+        let focus = magic_creatures(&r);
+        let spells = all_spells(&r);
+        let summons: Vec<SpellId> = spells
+            .iter()
+            .copied()
+            .filter(|&s| r.spell(s).unwrap().magic.summons())
+            .collect();
+        let creating: Vec<SpellId> = spells
+            .iter()
+            .copied()
+            .filter(|&s| {
+                let m = &r.spell(s).unwrap().magic;
+                m.summons() || m.clones() || m.raises()
+            })
+            .collect();
+        let mut s = setup(&r, &mut rng, 0);
+        // Full armies of many creatures, so that stacks live on, with raisers among them.
+        for (army, n) in [(&mut s.attacker, 7), (&mut s.defender, 7)] {
+            army.stacks = (0..n)
+                .map(|slot| ArmyStack {
+                    slot,
+                    creature: if slot == 6 {
+                        r.creature_by_key("t:fiend").unwrap()
+                    } else if chance(&mut rng, 40) {
+                        pick(&mut rng, &focus)
+                    } else {
+                        pick(&mut rng, &pool)
+                    },
+                    count: 200 + rng.below(2000),
+                })
+                .collect();
+        }
+        s.war_machines = [0, 1].map(|_| {
+            ["t:ballista", "t:cart", "t:tent"]
+                .iter()
+                .map(|k| r.creature_by_key(k).unwrap())
+                .collect()
+        });
+        s.obstacles.clear();
+        for side in 0..2 {
+            let mut h = hero(&r);
+            h.power = 1;
+            h.magic.mana = u16::MAX;
+            h.magic.spell_book = Some(
+                spells
+                    .iter()
+                    .copied()
+                    .filter(|&x| r.spell(x).unwrap().category != SpellCategory::Ability)
+                    .collect(),
+            );
+            h.magic.masteries = spells.iter().map(|&x| (x, 3)).collect();
+            s.heroes[side] = Some(h);
+        }
+        let mut state = BattleState::new(&r, &s, seed).unwrap();
+        let initial = [10, 10];
+        let mut targets = CastTargets::new();
+        let mut seconds = CastTargets::new();
+        let mut agent = Rng::from_seed(seed ^ 77);
+        for step in 0..900u32 {
+            let Some(side) = state.side_to_act() else {
+                break;
+            };
+            let castable = castable_spells(&state, &r, side);
+            // First the summons, then anything that creates a stack, then a random listed command.
+            let wanted: Vec<SpellId> = summons
+                .iter()
+                .chain(&creating)
+                .copied()
+                .filter(|&x| castable.contains(x))
+                .collect();
+            let cmd = if let Some(&spell) = wanted
+                .first()
+                .filter(|_| step < 400 || chance(&mut agent, 50))
+            {
+                cast_targets(&state, &r, side, spell, &mut targets);
+                let target = targets.as_slice()[agent.below(targets.len() as u32) as usize];
+                second_targets(&state, &r, side, (spell, target), &mut seconds);
+                let second = seconds.as_slice()[agent.below(seconds.len() as u32) as usize];
+                Command::Cast {
+                    spell,
+                    target,
+                    second,
+                }
+            } else {
+                let all = listed(&state, &r, side).unwrap();
+                if step % 16 == 0 {
+                    for c in &all {
+                        let mut probe = state.clone();
+                        apply(&mut probe, &r, side, *c, &mut crate::NoopSink)
+                            .unwrap_or_else(|e| panic!("seed {seed} step {step}: {c:?}: {e:?}"));
+                        check_state(&probe, &r, initial, false)
+                            .unwrap_or_else(|e| panic!("seed {seed} step {step}: {c:?}: {e}"));
+                    }
+                }
+                let staying: Vec<Command> =
+                    all.into_iter().filter(|c| !c.leaves_battle()).collect();
+                // Mostly defend while the sides fill up, then fight.
+                if step < 400 && chance(&mut agent, 85) {
+                    Command::Defend
+                } else {
+                    pick(&mut agent, &staying)
+                }
+            };
+            apply(&mut state, &r, side, cmd, &mut crate::NoopSink)
+                .unwrap_or_else(|e| panic!("seed {seed} step {step}: {cmd:?}: {e:?}"));
+            check_state(&state, &r, initial, true)
+                .unwrap_or_else(|e| panic!("seed {seed} step {step}: after {cmd:?}: {e}"));
+            most = most.max(state.stacks().len());
+        }
+        reached += u32::from(state.stacks().len() == crate::STACK_CAPACITY);
+    }
+    println!(
+        "capacity runs {games}: {reached} reached {} stacks, most {most}",
+        crate::STACK_CAPACITY
+    );
+    assert!(reached > 0);
+}

+/// How often a battlefield generated from the harvested packs leads a hero's Remove Obstacle
+/// into F-robust-2 (castable without a target): on each generated battlefield a hero removes
+/// obstacles at random listed hexes, one per round, while the spell is castable.
+/// `STRESS_GAMES` battlefields per terrain, `STRESS_STRICT`.
+#[test]
+#[ignore = "throwaway measurement"]
+fn remove_obstacle_on_generated_battlefields() {
+    use h3_battle::{
+        CastTarget, CastTargets, Command, NoopSink, apply, cast_targets, castable_spells,
+    };
+    let profile = if env_var("STRESS_STRICT", 0) != 0 {
+        "base:strict-fixed"
+    } else {
+        "base:faithful"
+    };
+    let r = h3_pack::compile(
+        &[h3_pack::SOD_PACK, h3_pack::AB_PACK, h3_pack::BASE_PACK],
+        profile,
+    )
+    .unwrap();
+    let n = env_var("STRESS_GAMES", 20_000);
+    let remove = r.spell_by_key("base:remove_obstacle").unwrap();
+    let pikeman = r.creature_by_key("base:pikeman").unwrap();
+    let army = || Army {
+        stacks: vec![ArmyStack {
+            slot: 0,
+            creature: pikeman,
+            count: 1,
+        }],
+    };
+    let mut hero = BattleHero::new(HeroTypeId::from_index(0).unwrap());
+    hero.magic.mana = 9999;
+    hero.magic.spell_book = Some(vec![remove]);
+    let (mut fields, mut with_pair, mut stuck, mut casts) = (0u64, 0u64, 0u64, 0u64);
+    let mut first: Vec<String> = Vec::new();
+    let mut per_terrain = BTreeMap::<String, (u64, u64, u64)>::new();
+    for (t, info) in r.terrains().iter().enumerate() {
+        let terrain = h3_content::TerrainId::from_index(t).unwrap();
+        for seed in 0..n {
+            let mut rng = Rng::for_stream(seed, StreamId::OBSTACLES);
+            let obstacles = h3_battle::generate_obstacles(&r, terrain, &mut rng);
+            fields += 1;
+            // A later obstacle whose hexes and anchor all lie on one earlier obstacle's hexes or
+            // anchor.
+            let pair = obstacles.iter().enumerate().any(|(j, x)| {
+                x.anchor.is_some_and(|xa| {
+                    obstacles[..j].iter().any(|y| {
+                        y.anchor.is_some_and(|ya| {
+                            x.hexes
+                                .iter()
+                                .chain([&xa])
+                                .all(|h| *h == ya || y.hexes.contains(h))
+                        })
+                    })
+                })
+            });
+            let entry = per_terrain
+                .entry(format!("{}", info.key.as_str()))
+                .or_default();
+            entry.0 += 1;
+            if pair {
+                with_pair += 1;
+                entry.1 += 1;
+            }
+            let setup = BattleSetup {
+                attacker: army(),
+                defender: army(),
+                obstacles: obstacles.clone(),
+                heroes: [Some(hero.clone()), None],
+                terrain: Some(terrain),
+                war_machines: [vec![], vec![]],
+                formations: [Formation::Loose; 2],
+                funds: [0; 2],
+            };
+            let mut state = BattleState::new(&r, &setup, seed).unwrap();
+            let mut agent = Rng::for_stream(seed, StreamId::AGENT);
+            let mut targets = CastTargets::new();
+            for _ in 0..40 {
+                let Some(side) = state.side_to_act() else {
+                    break;
+                };
+                if side == BattleSide::Attacker
+                    && castable_spells(&state, &r, side).contains(remove)
+                {
+                    cast_targets(&state, &r, side, remove, &mut targets);
+                    if targets.is_empty() {
+                        stuck += 1;
+                        entry.2 += 1;
+                        if first.len() < 5 {
+                            first.push(format!(
+                                "terrain {} seed {seed}: obstacles {obstacles:?}; left {:?}",
+                                info.key.as_str(),
+                                state.removable_obstacles()
+                            ));
+                        }
+                        break;
+                    }
+                    let target: CastTarget =
+                        targets.as_slice()[agent.below(targets.len() as u32) as usize];
+                    let cast = Command::Cast {
+                        spell: remove,
+                        target,
+                        second: CastTarget::None,
+                    };
+                    apply(&mut state, &r, side, cast, &mut NoopSink).unwrap();
+                    casts += 1;
+                }
+                apply(&mut state, &r, side, Command::Defend, &mut NoopSink).unwrap();
+            }
+        }
+    }
+    println!(
+        "{profile}: {fields} generated battlefields, {with_pair} with the pair, {casts} casts, {stuck} ended castable without a target"
+    );
+    println!("per terrain (fields, with the pair, stuck): {per_terrain:?}");
+    for f in &first {
+        println!("  {f}");
+    }
+}

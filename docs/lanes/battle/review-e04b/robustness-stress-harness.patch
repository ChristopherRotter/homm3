+/// Random setups, most of them unsound: `BattleState::new` answers, never panics; an accepted
+/// one plays a short battle.
+#[test]
+#[ignore = "throwaway stress run"]
+fn stress_setups() {
+    let games = env("STRESS_GAMES", 2000);
+    let first = env("STRESS_SEED", 1);
+    let opts = Opts {
+        steps: 40,
+        hero_cast: 40,
+        creature_cast: 35,
+        exhaustive_every: 0,
+        deep_every: 4,
+        count_events: false,
+        trace: false,
+    };
+    std::panic::set_hook(std::boxed::Box::new(|info| {
+        std::eprintln!("panic: {info}");
+        *LAST_PANIC.lock().unwrap() = Some(format!("{info}"));
+    }));
+    let rulesets: Vec<Ruleset> = ["t:faithful", "t:single", "t:anchors"]
+        .iter()
+        .map(|p| stress_ruleset(p, true, 20))
+        .collect();
+    let mut stats = Stats::default();
+    let mut errors: BTreeMap<String, u64> = BTreeMap::new();
+    let mut failures: Vec<(u64, String)> = Vec::new();
+    let (mut accepted, mut refused) = (0u64, 0u64);
+    for seed in first..first + games {
+        let r = &rulesets[(seed % 3) as usize];
+        let mut rng = Rng::from_seed(seed ^ 0xbad5_e700_0000_0000);
+        let tier = u8::try_from(1 + seed % 2).unwrap();
+        let mut s = setup(r, &mut rng, tier);
+        for _ in 0..1 + rng.below(3) {
+            corrupt(&mut s, &mut rng, r);
+        }
+        let built = catch_unwind(AssertUnwindSafe(|| {
+            BattleState::new(r, &s, seed).map(|_| ())
+        }));
+        match built {
+            Err(_) => {
+                let msg = LAST_PANIC.lock().unwrap().take().unwrap_or_default();
+                failures.push((
+                    seed,
+                    format!("seed {seed}: PANIC in BattleState::new: {msg}"),
+                ));
+            }
+            Ok(Err(e)) => {
+                refused += 1;
+                let name = format!("{e:?}");
+                let name: String = name.chars().filter(|c| !c.is_ascii_digit()).collect();
+                *errors.entry(name).or_default() += 1;
+            }
+            Ok(Ok(())) => {
+                accepted += 1;
+                let mut local = stats.clone();
+                let res = catch_unwind(AssertUnwindSafe(|| {
+                    play_one(r, &s, seed, &opts, &mut local)
+                }));
+                match res {
+                    Ok(Ok(())) => stats = local,
+                    Ok(Err(e)) => failures.push((seed, format!("seed {seed}: {e}"))),
+                    Err(_) => {
+                        let msg = LAST_PANIC.lock().unwrap().take().unwrap_or_default();
+                        failures.push((seed, format!("seed {seed}: PANIC {msg}")));
+                    }
+                }
+            }
+        }
+    }
+    let _ = std::panic::take_hook();
+    println!("setups {games}: accepted {accepted}, refused {refused}");
+    println!("refusals: {errors:?}");
+    report(&stats, &failures);
+    assert!(failures.is_empty());
+}

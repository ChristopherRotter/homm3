+//! THROWAWAY stress harness of the E04b robustness review (T11b). Not committed.
+//!
+//! Random battles on the harvested packs (`base`, `ab`, `sod`) in both quirk profiles, played
+//! through the sim's action encoding: the legal mask and the head masks choose every action,
+//! which must decode, encode back, validate and step; the flat observation must encode; the
+//! state's invariants must hold. At sampled steps every entry of the encoding (and some beyond)
+//! and every cast of the head masks is tried on a fork.
+
+use std::collections::BTreeMap;
+use std::num::NonZeroU32;
+use std::panic::{AssertUnwindSafe, catch_unwind};
+use std::sync::{Arc, Mutex};
+use std::time::Instant;
+
+use h3_battle::{
+    BattleState, Field, HexSet, LegalCommands, NO_CORPSE, StackId, StackTraits, Viewer, observe_as,
+    validate,
+};
+use h3_content::{
+    Ability, CLONE_ON_ITS_ORIGINAL, CreatureFlag, CreatureTypeId, EARLY_MASS_VERSION, Formation,
+    HeroTypeId, ObstacleKind, Ruleset, SchoolId, SpellCategory, SpellEffect, SpellId, SpellScope,
+    SpellTarget,
+};
+use h3_contracts::{
+    Army, ArmyStack, BallistaControl, BattleEffect, BattleHero, BattleSetup, BattleSide,
+    DamageBonuses, EagleEye, Rate, TentControl,
+};
+use h3_kernel::{Rng, StreamId};
+use h3_sim::action::{self, CREATURE_CAST, HERO_CAST, RETREAT, SURRENDER};
+use h3_sim::{ACTION_COUNT, Action, BattleEnv, OBSERVATION_LEN, SPELL_COUNT, TARGET_COUNT};
+
+static LAST_PANIC: Mutex<Option<String>> = Mutex::new(None);
+
+fn env_var(name: &str, default: u64) -> u64 {
+    std::env::var(name)
+        .ok()
+        .and_then(|v| v.parse().ok())
+        .unwrap_or(default)
+}
+
+fn pick<T: Copy>(rng: &mut Rng, items: &[T]) -> T {
+    items[rng.below(items.len() as u32) as usize]
+}
+
+fn chance(rng: &mut Rng, percent: u32) -> bool {
+    rng.below(100) < percent
+}
+
+fn all_spells(r: &Ruleset) -> Vec<SpellId> {
+    (0..r.spells().len())
+        .filter_map(SpellId::from_index)
+        .collect()
+}
+
+fn army_pool(r: &Ruleset) -> Vec<CreatureTypeId> {
+    (0..r.creature_count())
+        .filter_map(CreatureTypeId::from_index)
+        .filter(|&c| {
+            r.creature(c)
+                .is_some_and(|t| !t.flags.contains(CreatureFlag::WarMachine))
+        })
+        .collect()
+}
+
+/// The creatures with magic of their own.
+fn magic_pool(r: &Ruleset) -> Vec<CreatureTypeId> {
+    army_pool(r)
+        .into_iter()
+        .filter(|&c| {
+            r.abilities(c).iter().any(|a| {
+                matches!(
+                    a,
+                    Ability::SpellCaster { .. }
+                        | Ability::RandomSpellCaster { .. }
+                        | Ability::HelpfulSpellCaster { .. }
+                        | Ability::PeriodicSpellCaster { .. }
+                        | Ability::StackRaiser { .. }
+                        | Ability::CorpseRaiser { .. }
+                        | Ability::SpellAfterStrike { .. }
+                        | Ability::SpellDamageAfterStrike { .. }
+                        | Ability::DamageAfterStrike { .. }
+                        | Ability::InnateSpell { .. }
+                        | Ability::Rebirth { .. }
+                        | Ability::Fear { .. }
+                        | Ability::ManaDrain { .. }
+                        | Ability::ManaChannel { .. }
+                        | Ability::SpellCost { .. }
+                        | Ability::MagicResistance { .. }
+                        | Ability::MagicResistanceAura { .. }
+                        | Ability::SpellLevelImmunity { .. }
+                        | Ability::SpellDamageReduction { .. }
+                        | Ability::SchoolImmunity { .. }
+                        | Ability::SpellImmunity { .. }
+                        | Ability::SpellVulnerability { .. }
+                        | Ability::LifeDrain { .. }
+                        | Ability::DeathStare { .. }
+                )
+            })
+        })
+        .collect()
+}
+
+/// The war machines by kind: shooters, ammunition supplies, first aid.
+fn machines(r: &Ruleset) -> [Vec<CreatureTypeId>; 3] {
+    let mut out = [Vec::new(), Vec::new(), Vec::new()];
+    for c in (0..r.creature_count()).filter_map(CreatureTypeId::from_index) {
+        let t = r.creature(c).unwrap();
+        if !t.flags.contains(CreatureFlag::WarMachine) {
+            continue;
+        }
+        let a = r.abilities(c);
+        if t.flags.contains(CreatureFlag::Shooter) {
+            out[0].push(c);
+        } else if a.iter().any(|a| matches!(a, Ability::AmmoSupply)) {
+            out[1].push(c);
+        } else if a.iter().any(|a| matches!(a, Ability::FirstAid { .. })) {
+            out[2].push(c);
+        }
+    }
+    out
+}
+
+fn bp(rng: &mut Rng, tier: u8) -> u32 {
+    if tier == 0 {
+        pick(rng, &[0, 500, 1000, 1500, 2500, 5000, 10_000, 20_000])
+    } else {
+        match rng.below(9) {
+            0 => 0,
+            1 => 1,
+            2 => 500,
+            3 => 10_000,
+            4 => 65_535,
+            5 => 1_000_000,
+            6 => u32::MAX,
+            7 => rng.next_u32(),
+            _ => rng.below(100_000),
+        }
+    }
+}
+
+fn rate(rng: &mut Rng, tier: u8) -> Rate {
+    let single = if tier < 2 || chance(rng, 40) {
+        None
+    } else {
+        NonZeroU32::new(match rng.below(3) {
+            0 => rng.next_u32(),
+            1 => rng.next_u32() & 0x7fff_ffff,
+            _ => 0x3b80_0000 + rng.below(0x0c80_0000),
+        })
+    };
+    Rate {
+        bp: bp(rng, tier),
+        single,
+    }
+}
+
+/// A `SpellDamage` rate of the scopes that multiply: small with `STRESS_SAFE`, so that the known
+/// overflow of the spell damage (F-robust-3) does not end the battles early.
+fn damage_rate(rng: &mut Rng, tier: u8) -> Rate {
+    if env_var("STRESS_SAFE", 0) != 0 {
+        Rate::bp(pick(rng, &[0, 500, 5000, 20_000, 65_535]))
+    } else {
+        rate(rng, tier)
+    }
+}
+
+/// The `(spell, mastery)` pairs a hero may open with (as `h3_battle`'s check has them).
+fn openings(r: &Ruleset) -> Vec<(SpellId, u8)> {
+    let early = r.quirks().is_enabled(EARLY_MASS_VERSION);
+    let mut out = Vec::new();
+    for id in all_spells(r) {
+        let s = r.spell(id).unwrap();
+        for mastery in 0..=3u8 {
+            let kinds = !s.magic.effects.is_empty()
+                && s.magic.effects.iter().all(|e| {
+                    matches!(
+                        e,
+                        SpellEffect::Timed(_) | SpellEffect::Dispel | SpellEffect::Heal
+                    )
+                });
+            if s.category != SpellCategory::Ability
+                && kinds
+                && s.magic.target_at(mastery, early) == SpellTarget::None
+            {
+                out.push((id, mastery));
+            }
+        }
+    }
+    out
+}
+
+fn effects(r: &Ruleset, rng: &mut Rng, tier: u8) -> Vec<BattleEffect> {
+    let spells = all_spells(r);
+    let opening = openings(r);
+    let n = rng.below(if tier == 0 { 8 } else { 40 });
+    let mut out = Vec::new();
+    let mut own: Vec<SpellId> = Vec::new();
+    let mut opened = 0;
+    let mut durations = 0;
+    for _ in 0..n {
+        let mut own_spell = |rng: &mut Rng| {
+            if own.len() < h3_battle::MAX_SPELL_BONUSES {
+                let s = pick(rng, &spells);
+                if !own.contains(&s) {
+                    own.push(s);
+                }
+                s
+            } else {
+                pick(rng, &own)
+            }
+        };
+        let level = |rng: &mut Rng| -> u8 {
+            if tier == 0 {
+                u8::try_from(rng.below(6)).unwrap()
+            } else {
+                pick(rng, &[0, 1, 2, 3, 4, 5, 6, 100, 255])
+            }
+        };
+        let e = match rng.below(18) {
+            0 | 1 => BattleEffect::SpellDamage {
+                scope: SpellScope::All,
+                rate: damage_rate(rng, tier),
+            },
+            2 | 3 => BattleEffect::SpellDamage {
+                scope: SpellScope::School(
+                    SchoolId::from_index(rng.below(r.spell_schools().len() as u32) as usize)
+                        .unwrap(),
+                ),
+                rate: damage_rate(rng, tier),
+            },
+            4 => BattleEffect::SpellDamage {
+                scope: SpellScope::Spell(own_spell(rng)),
+                rate: rate(rng, tier),
+            },
+            5 | 6 => BattleEffect::SpellSpecialty {
+                spell: own_spell(rng),
+                bp_per_level: if tier == 0 {
+                    300
+                } else {
+                    pick(rng, &[0, 1, 300, 500, 10_000, u16::MAX])
+                },
+                level: if tier == 0 {
+                    u8::try_from(1 + rng.below(40)).unwrap()
+                } else {
+                    pick(rng, &[0, 1, 5, 30, 74, 255])
+                },
+            },
+            7 | 8 => BattleEffect::MagicResistance {
+                rate: if tier == 0 {
+                    Rate::bp(pick(rng, &[500, 1000, 2000, 3000]))
+                } else {
+                    rate(rng, tier)
+                },
+            },
+            9 => {
+                if tier == 0 && durations > 0 {
+                    continue;
+                }
+                durations += 1;
+                BattleEffect::SpellDuration {
+                    rounds: if tier == 0 {
+                        u8::try_from(1 + rng.below(6)).unwrap()
+                    } else {
+                        pick(rng, &[0, 1, 3, 56, 255])
+                    },
+                }
+            }
+            10 => {
+                if !chance(rng, 4) {
+                    continue;
+                }
+                BattleEffect::NoCasting
+            }
+            11 => {
+                if !chance(rng, 25) {
+                    continue;
+                }
+                BattleEffect::SpellLevelLimit {
+                    max_level: if tier == 0 { 2 } else { level(rng) },
+                }
+            }
+            12 => BattleEffect::SpellImmunity {
+                spell: pick(rng, &spells),
+            },
+            13 => {
+                if !chance(rng, 30) {
+                    continue;
+                }
+                BattleEffect::SpellLevelImmunity {
+                    max_level: if tier == 0 { 4 } else { level(rng) },
+                }
+            }
+            14 => BattleEffect::MindImmunity,
+            15 => BattleEffect::NegateImmunities,
+            _ => {
+                if opened >= h3_battle::MAX_OPENING_SPELLS || opening.is_empty() {
+                    continue;
+                }
+                opened += 1;
+                let (spell, mastery) = pick(rng, &opening);
+                BattleEffect::OpeningSpell {
+                    spell,
+                    mastery,
+                    power: if tier == 0 {
+                        u16::try_from(1 + rng.below(20)).unwrap()
+                    } else {
+                        pick(rng, &[1, 2, 8, 255, 256, 30_000, u16::MAX])
+                    },
+                }
+            }
+        };
+        out.push(e);
+    }
+    out
+}
+
+fn caster(r: &Ruleset, rng: &mut Rng, tier: u8) -> BattleHero {
+    let mut h = BattleHero::new(
+        HeroTypeId::from_index(rng.below(r.hero_types().len() as u32) as usize).unwrap(),
+    );
+    let primary = |rng: &mut Rng| -> u8 {
+        if tier == 0 {
+            u8::try_from(rng.below(31)).unwrap()
+        } else {
+            pick(rng, &[0, 1, 2, 7, 30, 99, 150, 255])
+        }
+    };
+    h.attack = primary(rng);
+    h.defense = primary(rng);
+    h.power = primary(rng);
+    h.knowledge = primary(rng);
+    h.tactics = if chance(rng, 10) {
+        u8::try_from(rng.below(4)).unwrap()
+    } else {
+        0
+    };
+    h.damage = DamageBonuses {
+        ranged: rate(rng, tier),
+        melee: rate(rng, tier),
+        reduction: Rate::bp(pick(rng, &[0, 500, 1500, 10_000])),
+    };
+    if chance(rng, 40) {
+        h.war_machines.ballista = Some(BallistaControl {
+            shots: u8::try_from(1 + rng.below(2)).unwrap(),
+            double_damage_chance_bp: pick(rng, &[0, 5000, 10_000]),
+        });
+    }
+    if chance(rng, 40) {
+        h.war_machines.tent = Some(TentControl {
+            heal_bonus: rate(rng, tier),
+        });
+    }
+    h.surrender_discount_bp = pick(rng, &[0, 2000, 10_000]);
+    let spells = all_spells(r);
+    let hero_spells: Vec<SpellId> = spells
+        .iter()
+        .copied()
+        .filter(|&s| r.spell(s).unwrap().category != SpellCategory::Ability)
+        .collect();
+    if chance(rng, 96) {
+        let keep = if chance(rng, 80) { 100 } else { 60 };
+        h.magic.spell_book = Some(
+            hero_spells
+                .iter()
+                .copied()
+                .filter(|_| chance(rng, keep))
+                .collect(),
+        );
+    }
+    let style = rng.below(6);
+    h.magic.masteries = spells
+        .iter()
+        .filter_map(|&s| {
+            let m = match style {
+                0 => 0,
+                1 => 1,
+                2 => 2,
+                3 => 3,
+                _ => u8::try_from(rng.below(4)).unwrap(),
+            };
+            (m > 0).then_some((s, m))
+        })
+        .collect();
+    h.magic.mana = if tier == 0 {
+        pick(rng, &[0, 10, 40, 150, 500, 999])
+    } else {
+        pick(rng, &[0, 3, 20, 200, 5000, u16::MAX])
+    };
+    h.magic.max_mana = pick(rng, &[0, 10, 500, u16::MAX]);
+    if chance(rng, 30) {
+        h.magic.eagle_eye = Some(EagleEye {
+            chance: Rate::bp(pick(rng, &[0, 4000, 10_000])),
+            spells: hero_spells
+                .iter()
+                .copied()
+                .filter(|_| chance(rng, 50))
+                .collect(),
+        });
+    }
+    h.effects = effects(r, rng, tier);
+    h
+}
+
+fn count(rng: &mut Rng, tier: u8) -> u32 {
+    if tier == 0 {
+        match rng.below(10) {
+            0..=4 => 1 + rng.below(30),
+            5..=7 => 1 + rng.below(500),
+            _ => 1 + rng.below(20_000),
+        }
+    } else {
+        match rng.below(10) {
+            0..=3 => 1 + rng.below(100),
+            4..=5 => 60_000 + rng.below(140_000),
+            6..=7 => 1 + rng.below(u32::MAX),
+            8 => u32::MAX,
+            _ => 1 + rng.below(3),
+        }
+    }
+}
+
+struct Pools {
+    army: Vec<CreatureTypeId>,
+    magic: Vec<CreatureTypeId>,
+    machines: [Vec<CreatureTypeId>; 3],
+}
+
+fn army(rng: &mut Rng, tier: u8, p: &Pools) -> Army {
+    let n = 1 + rng.below(7);
+    let mut slots: Vec<u8> = (0..7).collect();
+    let mut stacks = Vec::new();
+    for _ in 0..n {
+        let slot = slots.remove(rng.below(slots.len() as u32) as usize);
+        let creature = if chance(rng, 50) {
+            pick(rng, &p.magic)
+        } else {
+            pick(rng, &p.army)
+        };
+        stacks.push(ArmyStack {
+            slot,
+            creature,
+            count: count(rng, tier),
+        });
+    }
+    Army { stacks }
+}
+
+fn setup(r: &Ruleset, rng: &mut Rng, tier: u8, p: &Pools) -> BattleSetup {
+    let war = |rng: &mut Rng| -> Vec<CreatureTypeId> {
+        p.machines
+            .iter()
+            .filter(|kind| !kind.is_empty())
+            .filter_map(|kind| chance(rng, 35).then(|| pick(rng, kind)))
+            .collect()
+    };
+    let terrains = r.terrains().len() as u32;
+    BattleSetup {
+        attacker: army(rng, tier, p),
+        defender: army(rng, tier, p),
+        obstacles: vec![],
+        heroes: [
+            chance(rng, 92).then(|| caster(r, rng, tier)),
+            chance(rng, 85).then(|| caster(r, rng, tier)),
+        ],
+        terrain: chance(rng, 70)
+            .then(|| h3_content::TerrainId::from_index(rng.below(terrains) as usize))
+            .flatten(),
+        war_machines: [war(rng), war(rng)],
+        formations: [
+            pick(rng, &[Formation::Loose, Formation::Tight]),
+            pick(rng, &[Formation::Loose, Formation::Tight]),
+        ],
+        funds: [rng.next_u32(), pick(rng, &[0, 1000, u32::MAX])],
+    }
+}
+
+macro_rules! ensure {
+    ($cond:expr, $($arg:tt)*) => {
+        if !$cond {
+            return Err(format!($($arg)*));
+        }
+    };
+}
+
+fn check_state(state: &BattleState, r: &Ruleset, initial: [usize; 2]) -> Result<(), String> {
+    let field = Field::new(r.battle().field);
+    let stacks = state.stacks();
+    let effects = state.effects();
+    for w in effects.windows(2) {
+        ensure!(
+            (w[0].stack, w[0].spell) < (w[1].stack, w[1].spell),
+            "effects not sorted or not unique: {:?} {:?}",
+            w[0],
+            w[1]
+        );
+    }
+    for e in effects {
+        ensure!(e.stack.index() < stacks.len(), "effect on no stack: {e:?}");
+        ensure!(
+            stacks[e.stack.index()].is_alive(),
+            "effect on a dead stack: {e:?}"
+        );
+        ensure!(e.rounds != Some(0), "effect with 0 rounds: {e:?}");
+        ensure!(
+            r.spell(e.spell).is_some_and(|s| s.magic.is_timed()),
+            "effect of a spell that is not timed: {e:?}"
+        );
+    }
+    ensure!(
+        state.is_over() == state.active().is_none(),
+        "over {} but active {:?}",
+        state.is_over(),
+        state.active()
+    );
+    if let Some(a) = state.active() {
+        ensure!(
+            stacks.get(a.index()).is_some_and(|s| s.is_alive()),
+            "the active stack {a:?} is dead or missing"
+        );
+    }
+    let walls = state
+        .spell_obstacles()
+        .iter()
+        .filter(|o| o.kind == ObstacleKind::Wall)
+        .fold(HexSet::new(), |set, o| set.union(o.hexes));
+    let mut taken = HexSet::new();
+    let turned = r.quirks().is_enabled(CLONE_ON_ITS_ORIGINAL);
+    let good = i8::try_from(r.battle().good_morale.levels()).unwrap();
+    let bad = i8::try_from(r.battle().bad_morale.levels()).unwrap();
+    let lucky = i8::try_from(r.battle().good_luck.levels()).unwrap();
+    for (i, s) in stacks.iter().enumerate() {
+        let id = StackId(u8::try_from(i).unwrap());
+        ensure!(
+            s.max_hp >= 1,
+            "stack {i} has no hit points per creature: {s:?}"
+        );
+        ensure!(
+            s.count <= s.base_count,
+            "stack {i}: count {} above its base {}",
+            s.count,
+            s.base_count
+        );
+        ensure!(
+            state.temporary(id) <= s.base_count,
+            "stack {i}: temporary above its base"
+        );
+        if s.is_alive() {
+            ensure!(
+                (1..=s.max_hp).contains(&s.top_hp),
+                "stack {i}: top hp {} of {}",
+                s.top_hp,
+                s.max_hp
+            );
+            let Some(fp) = field.footprint(s.hex, s.is_two_hex(), s.side) else {
+                return Err(format!("stack {i} is off the field: {s:?}"));
+            };
+            for h in fp.hexes() {
+                ensure!(!taken.contains(h), "two living stacks on {h:?} (stack {i})");
+                taken.insert(h);
+                ensure!(
+                    !state.obstacles().contains(h),
+                    "stack {i} stands on a natural obstacle at {h:?}"
+                );
+                ensure!(!walls.contains(h), "stack {i} stands in a wall at {h:?}");
+                ensure!(
+                    field.is_standable(h) || s.has(StackTraits::WAR_MACHINE),
+                    "stack {i} stands on the side column hex {h:?}"
+                );
+            }
+            ensure!(state.corpse(id) == 0, "the living stack {i} has a corpse");
+        } else {
+            ensure!(s.top_hp == 0, "the dead stack {i} has top hp {}", s.top_hp);
+            ensure!(
+                !s.is_created() || state.corpse(id) == NO_CORPSE,
+                "the dead created stack {i} left a corpse"
+            );
+            ensure!(
+                state.is_over() || state.corpse(id) != 0,
+                "the dead stack {i} has no corpse mark after the command"
+            );
+        }
+        let clone = s.is_alive() && s.has(StackTraits::CLONE);
+        if turned {
+            ensure!(
+                !clone || state.clone_rounds(id) > 0,
+                "clone {i} without rounds"
+            );
+        } else {
+            ensure!(
+                clone == (state.clone_rounds(id) > 0),
+                "stack {i}: clone {clone} but rounds {}",
+                state.clone_rounds(id)
+            );
+        }
+        ensure!(
+            (-bad..=good).contains(&s.morale) && (0..=lucky).contains(&s.luck),
+            "stack {i}: morale {} luck {}",
+            s.morale,
+            s.luck
+        );
+    }
+    for side in BattleSide::BOTH {
+        let n = stacks.iter().filter(|s| s.side == side).count();
+        let limit = usize::from(r.battle().side_stack_limit).max(initial[side.index()]);
+        ensure!(n <= limit, "{side:?} has {n} stacks, limit {limit}");
+    }
+    let obs = observe_as(state, r, Viewer::Spectator);
+    for (i, link) in obs.clone_links.iter().enumerate() {
+        if let Some(l) = link {
+            ensure!(
+                obs.clone_links.get(l.index()).copied().flatten()
+                    == Some(StackId(u8::try_from(i).unwrap())),
+                "stack {i}: its link {l:?} does not link back"
+            );
+        }
+    }
+    for (i, &binders) in obs.binders.iter().enumerate() {
+        if binders == 0 {
+            continue;
+        }
+        ensure!(
+            i < stacks.len() && stacks[i].is_alive(),
+            "binders on the dead or missing stack {i}"
+        );
+        for b in 0..64usize {
+            if binders & (1 << b) != 0 {
+                ensure!(
+                    stacks.get(b).is_some_and(|s| s.is_alive()),
+                    "stack {i} is bound by the dead or missing stack {b}"
+                );
+            }
+        }
+    }
+    Ok(())
+}
+
+#[derive(Debug, Default, Clone)]
+struct Stats {
+    battles: u64,
+    steps: u64,
+    finished: u64,
+    unfinished: u64,
+    refused: u64,
+    hero_casts: u64,
+    creature_casts: u64,
+    exhaustive: u64,
+    probed: u64,
+    max_micros: u128,
+    max_micros_at: (u64, u64),
+    max_round: u16,
+    max_effects: usize,
+    max_obstacles: usize,
+    casts: BTreeMap<String, u64>,
+    creature_spells: BTreeMap<String, u64>,
+}
+
+#[derive(Debug, Clone, Copy)]
+struct Opts {
+    steps: u64,
+    hero_cast: u32,
+    creature_cast: u32,
+    exhaustive_every: u32,
+    trace: bool,
+}
+
+fn set_bits(mask: &[bool]) -> Vec<usize> {
+    mask.iter()
+        .enumerate()
+        .filter(|(_, m)| **m)
+        .map(|(i, _)| i)
+        .collect()
+}
+
+/// Every action the masks allow now, the non-cast entries and the casts head by head.
+fn listed(env: &BattleEnv, side: BattleSide) -> Result<Vec<Action>, String> {
+    let mut legal = LegalCommands::new();
+    let mut mask = [false; ACTION_COUNT];
+    let mut spells = [false; SPELL_COUNT];
+    let mut targets = [false; TARGET_COUNT];
+    let mut seconds = [false; TARGET_COUNT];
+    env.legal_mask(side, &mut legal, &mut mask);
+    let mut out = Vec::new();
+    for entry in set_bits(&mask) {
+        env.spell_mask(side, entry, &mut legal, &mut spells);
+        let s = set_bits(&spells);
+        ensure!(!s.is_empty(), "entry {entry}: no spell head");
+        for spell in s {
+            let spell = u16::try_from(spell).unwrap();
+            env.target_mask(side, (entry, spell), &mut legal, &mut targets);
+            let t = set_bits(&targets);
+            ensure!(!t.is_empty(), "entry {entry} spell {spell}: no target head");
+            for target in t {
+                let target = u16::try_from(target).unwrap();
+                env.second_mask(side, (entry, spell, target), &mut legal, &mut seconds);
+                let s2 = set_bits(&seconds);
+                ensure!(
+                    !s2.is_empty(),
+                    "entry {entry} spell {spell} target {target}: no second head"
+                );
+                for second in s2 {
+                    out.push(Action {
+                        entry: u32::try_from(entry).unwrap(),
+                        spell,
+                        target,
+                        second: u16::try_from(second).unwrap(),
+                    });
+                }
+            }
+        }
+    }
+    Ok(out)
+}
+
+fn play_one(
+    r: &Arc<Ruleset>,
+    setup: &Arc<BattleSetup>,
+    seed: u64,
+    opts: &Opts,
+    stats: &mut Stats,
+) -> Result<(), String> {
+    // Half the battles on a terrain get its random obstacles (BAT-GEO-004).
+    let built = if seed % 2 == 0 {
+        BattleEnv::with_random_obstacles(r.clone(), setup.clone(), seed, 0)
+    } else {
+        BattleEnv::new(r.clone(), setup.clone(), seed, 0)
+    };
+    let mut env = match built {
+        Ok(e) => e,
+        Err(e) => {
+            stats.refused += 1;
+            return Err(format!("setup refused: {e:?}"));
+        }
+    };
+    let initial = BattleSide::BOTH.map(|side| {
+        env.state()
+            .stacks()
+            .iter()
+            .filter(|s| s.side == side)
+            .count()
+    });
+    check_state(env.state(), r, initial).map_err(|e| format!("at the start: {e}"))?;
+    let mut agent = Rng::for_stream(seed, StreamId::AGENT);
+    let mut legal = LegalCommands::new();
+    let mut mask = [false; ACTION_COUNT];
+    let mut spells = [false; SPELL_COUNT];
+    let mut targets = [false; TARGET_COUNT];
+    let mut seconds = [false; TARGET_COUNT];
+    let mut obs = vec![0f32; OBSERVATION_LEN];
+    let mut step = 0u64;
+    let total = opts.steps + opts.steps / 2;
+    while let Some(side) = env.to_move() {
+        if step >= total {
+            break;
+        }
+        let closing = step >= opts.steps;
+        step += 1;
+        let round = env.state().round();
+        let ctx = |what: &str| format!("step {step} (round {round}): {what}");
+
+        // The other side's masks are empty.
+        env.legal_mask(side.opponent(), &mut legal, &mut mask);
+        ensure!(
+            mask.iter().all(|m| !m),
+            "{}",
+            ctx("the other side has legal entries")
+        );
+
+        if opts.exhaustive_every > 0 && agent.below(opts.exhaustive_every) == 0 {
+            stats.exhaustive += 1;
+            let all = listed(&env, side).map_err(|e| ctx(&e))?;
+            for a in &all {
+                let mut fork = env.fork();
+                let res = catch_unwind(AssertUnwindSafe(|| fork.step(side, *a)));
+                match res {
+                    Err(_) => {
+                        let msg = LAST_PANIC.lock().unwrap().take().unwrap_or_default();
+                        return Err(ctx(&format!("PANIC in the probe of {a:?}: {msg}")));
+                    }
+                    Ok(Err(e)) => return Err(ctx(&format!("listed {a:?} refused: {e:?}"))),
+                    Ok(Ok(_)) => {}
+                }
+                stats.probed += 1;
+                check_state(fork.state(), r, initial)
+                    .map_err(|e| ctx(&format!("after the probe of {a:?}: {e}")))?;
+            }
+            // Every entry of the encoding and some beyond it, with heads 0: accepted exactly
+            // when listed; a refusal changes nothing.
+            let hash = env.state_hash();
+            for entry in 0..ACTION_COUNT + 6 {
+                let a = Action::entry(entry);
+                let mut fork = env.fork();
+                let ok = fork.step(side, a).is_ok();
+                ensure!(
+                    ok == all.contains(&a),
+                    "{}",
+                    ctx(&format!("entry {entry}: stepped {ok}, listed {}", !ok))
+                );
+                ensure!(
+                    ok || fork.state_hash() == hash,
+                    "{}",
+                    ctx(&format!("the refused entry {entry} changed the state"))
+                );
+            }
+            // Random heads, in and out of range.
+            for _ in 0..200 {
+                let a = Action {
+                    entry: match agent.below(4) {
+                        0 => HERO_CAST as u32,
+                        1 => CREATURE_CAST as u32,
+                        2 => agent.below(ACTION_COUNT as u32 + 10),
+                        _ => agent.next_u32(),
+                    },
+                    spell: match agent.below(3) {
+                        0 => 0,
+                        1 => u16::try_from(agent.below(SPELL_COUNT as u32 + 4)).unwrap(),
+                        _ => u16::try_from(agent.below(65_536)).unwrap(),
+                    },
+                    target: match agent.below(3) {
+                        0 => 0,
+                        1 => u16::try_from(agent.below(TARGET_COUNT as u32 + 4)).unwrap(),
+                        _ => u16::try_from(agent.below(65_536)).unwrap(),
+                    },
+                    second: match agent.below(3) {
+                        0 | 1 => 0,
+                        _ => u16::try_from(agent.below(TARGET_COUNT as u32 + 4)).unwrap(),
+                    },
+                };
+                let mut fork = env.fork();
+                let ok = fork.step(side, a).is_ok();
+                ensure!(
+                    ok == all.contains(&a),
+                    "{}",
+                    ctx(&format!("{a:?}: stepped {ok}, listed {}", !ok))
+                );
+                ensure!(
+                    ok || fork.state_hash() == hash,
+                    "{}",
+                    ctx(&format!("the refused {a:?} changed the state"))
+                );
+                // The head masks answer any prefix without failing.
+                env.spell_mask(side, a.entry as usize, &mut legal, &mut spells);
+                env.target_mask(side, (a.entry as usize, a.spell), &mut legal, &mut targets);
+                env.second_mask(
+                    side,
+                    (a.entry as usize, a.spell, a.target),
+                    &mut legal,
+                    &mut seconds,
+                );
+            }
+        }
+
+        env.legal_mask(side, &mut legal, &mut mask);
+        let entries = set_bits(&mask);
+        ensure!(!entries.is_empty(), "{}", ctx("no legal entry"));
+        let roll = agent.below(100);
+        let entry = if !closing && mask[HERO_CAST] && roll < opts.hero_cast {
+            HERO_CAST
+        } else if !closing && mask[CREATURE_CAST] && roll < opts.hero_cast + opts.creature_cast {
+            CREATURE_CAST
+        } else {
+            let staying: Vec<usize> = entries
+                .iter()
+                .copied()
+                .filter(|&e| e != RETREAT && e != SURRENDER && e != HERO_CAST && e != CREATURE_CAST)
+                .collect();
+            let strikes: Vec<usize> = staying
+                .iter()
+                .copied()
+                .filter(|&e| (257..action::END_TACTICS - 42).contains(&e))
+                .collect();
+            if !closing && agent.below(1000) < 2 {
+                pick(&mut agent, &entries)
+            } else if !strikes.is_empty() && (closing || agent.below(100) < 45) {
+                pick(&mut agent, &strikes)
+            } else {
+                pick(&mut agent, &staying)
+            }
+        };
+        env.spell_mask(side, entry, &mut legal, &mut spells);
+        let s = set_bits(&spells);
+        ensure!(
+            !s.is_empty(),
+            "{}",
+            ctx(&format!("entry {entry}: no spell head"))
+        );
+        let spell = u16::try_from(pick(&mut agent, &s)).unwrap();
+        env.target_mask(side, (entry, spell), &mut legal, &mut targets);
+        let t = set_bits(&targets);
+        ensure!(
+            !t.is_empty(),
+            "{}",
+            ctx(&format!("entry {entry} spell {spell}: no target head"))
+        );
+        let target = u16::try_from(pick(&mut agent, &t)).unwrap();
+        env.second_mask(side, (entry, spell, target), &mut legal, &mut seconds);
+        let s2 = set_bits(&seconds);
+        ensure!(
+            !s2.is_empty(),
+            "{}",
+            ctx(&format!(
+                "entry {entry} spell {spell} target {target}: no second head"
+            ))
+        );
+        let second = u16::try_from(pick(&mut agent, &s2)).unwrap();
+        let a = Action {
+            entry: u32::try_from(entry).unwrap(),
+            spell,
+            target,
+            second,
+        };
+        // The action decodes, encodes back and validates.
+        let Some(cmd) = action::decode(env.state(), r, a) else {
+            return Err(ctx(&format!("the listed {a:?} does not decode")));
+        };
+        ensure!(
+            action::encode(env.state(), r, cmd) == Some(a),
+            "{}",
+            ctx(&format!(
+                "{a:?} decodes to {cmd:?}, which encodes to {:?}",
+                action::encode(env.state(), r, cmd)
+            ))
+        );
+        ensure!(
+            validate(env.state(), r, side, cmd).is_ok(),
+            "{}",
+            ctx(&format!("the listed {cmd:?} does not validate"))
+        );
+        if entry == HERO_CAST {
+            stats.hero_casts += 1;
+            let key = r
+                .spell(SpellId::from_raw(spell))
+                .map_or("?", |s| s.key.as_str());
+            *stats.casts.entry(key.to_owned()).or_default() += 1;
+        } else if entry == CREATURE_CAST {
+            stats.creature_casts += 1;
+            let key = r
+                .spell(SpellId::from_raw(spell))
+                .filter(|_| spell != 0)
+                .map_or("(drawn at the cast or a raise)", |s| s.key.as_str());
+            *stats.creature_spells.entry(key.to_owned()).or_default() += 1;
+        }
+        if opts.trace {
+            println!("    step {step} round {round} {side:?}: {cmd:?}");
+        }
+        let t0 = Instant::now();
+        let res = env.step(side, a);
+        let micros = t0.elapsed().as_micros();
+        if let Err(e) = res {
+            return Err(ctx(&format!("the listed {cmd:?} was refused: {e:?}")));
+        }
+        stats.steps += 1;
+        if micros > stats.max_micros {
+            stats.max_micros = micros;
+            stats.max_micros_at = (seed, step);
+        }
+        stats.max_round = stats.max_round.max(env.state().round());
+        stats.max_effects = stats.max_effects.max(env.state().effects().len());
+        stats.max_obstacles = stats.max_obstacles.max(env.state().spell_obstacles().len());
+        check_state(env.state(), r, initial)
+            .map_err(|e| format!("step {step}: after {cmd:?}: {e}"))?;
+        for viewer in BattleSide::BOTH {
+            ensure!(
+                env.encode_observation(viewer, &mut obs).is_ok(),
+                "{}",
+                ctx("the observation does not encode")
+            );
+            ensure!(
+                obs.iter().all(|v| v.is_finite()),
+                "{}",
+                ctx("the observation has a value that is not finite")
+            );
+        }
+    }
+    if env.state().is_over() {
+        stats.finished += 1;
+        ensure!(env.state().outcome().is_some(), "over without an outcome");
+        let o = env.state().outcome().unwrap();
+        for side in BattleSide::BOTH {
+            // One survivor per army slot, in slot order (the outcome's debug assertion).
+            let survivors = &o.survivors[side.index()].stacks;
+            ensure!(
+                survivors.windows(2).all(|w| w[0].slot < w[1].slot),
+                "survivors not one per slot in slot order: {survivors:?}"
+            );
+            ensure!(
+                survivors.iter().all(|s| s.count > 0),
+                "a survivor without creatures: {survivors:?}"
+            );
+        }
+    } else {
+        stats.unfinished += 1;
+    }
+    Ok(())
+}
+
+fn run(profile: &str, tier: u8, first: u64, games: u64, opts: &Opts) -> (Stats, Vec<String>) {
+    std::panic::set_hook(Box::new(|info| {
+        *LAST_PANIC.lock().unwrap() = Some(format!("{info}"));
+    }));
+    let r = Arc::new(
+        h3_pack::compile(
+            &[h3_pack::SOD_PACK, h3_pack::AB_PACK, h3_pack::BASE_PACK],
+            profile,
+        )
+        .unwrap(),
+    );
+    let pools = Pools {
+        army: army_pool(&r),
+        magic: magic_pool(&r),
+        machines: machines(&r),
+    };
+    println!(
+        "{} creatures ({} with magic), machines {:?}, {} spells, {} openings",
+        pools.army.len(),
+        pools.magic.len(),
+        pools.machines.iter().map(Vec::len).collect::<Vec<_>>(),
+        r.spells().len(),
+        openings(&r).len()
+    );
+    let mut stats = Stats::default();
+    let mut failures = Vec::new();
+    let started = Instant::now();
+    for seed in first..first + games {
+        let mut rng = Rng::from_seed(seed ^ 0x4a52_0000_0000_0000 ^ (u64::from(tier) << 40));
+        let setup = Arc::new(setup(&r, &mut rng, tier, &pools));
+        stats.battles += 1;
+        let mut local = stats.clone();
+        let res = catch_unwind(AssertUnwindSafe(|| {
+            play_one(&r, &setup, seed, opts, &mut local)
+        }));
+        let label = format!("{profile} tier {tier} seed {seed}");
+        match res {
+            Ok(Ok(())) => stats = local,
+            Ok(Err(e)) => {
+                stats = local;
+                failures.push(format!("{label}: {e}"));
+            }
+            Err(_) => {
+                let msg = LAST_PANIC.lock().unwrap().take().unwrap_or_default();
+                failures.push(format!("{label}: PANIC {msg}"));
+            }
+        }
+        if (seed - first + 1) % 250 == 0 {
+            println!(
+                "[{:>7.1}s] {} battles, {} steps, {} failures, finished {}, hero casts {}, creature casts {}",
+                started.elapsed().as_secs_f64(),
+                stats.battles,
+                stats.steps,
+                failures.len(),
+                stats.finished,
+                stats.hero_casts,
+                stats.creature_casts
+            );
+        }
+    }
+    let _ = std::panic::take_hook();
+    (stats, failures)
+}
+
+fn report(stats: &Stats, failures: &[String]) {
+    println!(
+        "battles {} steps {} finished {} unfinished {} refused {}",
+        stats.battles, stats.steps, stats.finished, stats.unfinished, stats.refused
+    );
+    println!(
+        "hero casts {} creature casts {} exhaustive steps {} probes {}",
+        stats.hero_casts, stats.creature_casts, stats.exhaustive, stats.probed
+    );
+    println!(
+        "slowest step {} us at {:?}; max round {}; max effects {}; max spell obstacles {}",
+        stats.max_micros,
+        stats.max_micros_at,
+        stats.max_round,
+        stats.max_effects,
+        stats.max_obstacles
+    );
+    println!(
+        "hero spells cast ({}): {:?}",
+        stats.casts.len(),
+        stats.casts
+    );
+    println!("creature casts: {:?}", stats.creature_spells);
+    let mut groups: BTreeMap<String, (u64, String)> = BTreeMap::new();
+    for f in failures {
+        let tail = f.split_once(": ").map_or(f.as_str(), |x| x.1);
+        let key: String = tail
+            .chars()
+            .filter(|c| !c.is_ascii_digit())
+            .take(160)
+            .collect();
+        let entry = groups.entry(key).or_insert((0, f.clone()));
+        entry.0 += 1;
+    }
+    println!("{} failures in {} groups", failures.len(), groups.len());
+    for (n, first) in groups.values() {
+        println!("  x{n}: {first}");
+    }
+}
+
+/// `STRESS_GAMES`, `STRESS_SEED`, `STRESS_TIER`, `STRESS_STEPS`, `STRESS_STRICT` (1: the
+/// `strict-fixed` profile), `STRESS_EXHAUSTIVE`, `STRESS_TRACE`.
+#[test]
+#[ignore = "throwaway stress run"]
+fn stress_harvested() {
+    let games = env_var("STRESS_GAMES", 100);
+    let first = env_var("STRESS_SEED", 1);
+    let tier = u8::try_from(env_var("STRESS_TIER", 0)).unwrap();
+    let profile = if env_var("STRESS_STRICT", 0) != 0 {
+        "base:strict-fixed"
+    } else {
+        "base:faithful"
+    };
+    let opts = Opts {
+        steps: env_var("STRESS_STEPS", 300),
+        hero_cast: u32::try_from(env_var("STRESS_HERO", 40)).unwrap(),
+        creature_cast: u32::try_from(env_var("STRESS_CREATURE", 40)).unwrap(),
+        exhaustive_every: u32::try_from(env_var("STRESS_EXHAUSTIVE", 40)).unwrap(),
+        trace: env_var("STRESS_TRACE", 0) != 0,
+    };
+    println!(
+        "{profile} tier {tier} seeds {first}..{} {opts:?}",
+        first + games
+    );
+    let (stats, failures) = run(profile, tier, first, games, &opts);
+    report(&stats, &failures);
+    assert!(failures.is_empty(), "{} failures", failures.len());
+}

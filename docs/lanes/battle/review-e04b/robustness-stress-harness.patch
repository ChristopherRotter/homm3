+/// `STRESS_GAMES`, `STRESS_SEED`, `STRESS_TIER`, `STRESS_STEPS`, `STRESS_PROFILE` (index or
+/// absent for all), `STRESS_EXHAUSTIVE` (one step in so many, 0 never), `STRESS_DEEP`,
+/// `STRESS_EVENTS`, `STRESS_TRACE`.
+#[test]
+#[ignore = "throwaway stress run"]
+fn stress_synthetic() {
+    let games = env("STRESS_GAMES", 200);
+    let first = env("STRESS_SEED", 1);
+    let tier = u8::try_from(env("STRESS_TIER", 1)).unwrap();
+    let opts = Opts {
+        steps: env("STRESS_STEPS", 300),
+        hero_cast: u32::try_from(env("STRESS_HERO", 40)).unwrap(),
+        creature_cast: u32::try_from(env("STRESS_CREATURE", 35)).unwrap(),
+        exhaustive_every: u32::try_from(env("STRESS_EXHAUSTIVE", 25)).unwrap(),
+        deep_every: u32::try_from(env("STRESS_DEEP", 4)).unwrap(),
+        count_events: env("STRESS_EVENTS", 0) != 0,
+        trace: env("STRESS_TRACE", 0) != 0,
+    };
+    let profiles: Vec<&str> = match std::env::var("STRESS_PROFILE") {
+        Ok(p) => vec![PROFILES[p.parse::<usize>().unwrap()]],
+        Err(_) => PROFILES.to_vec(),
+    };
+    println!(
+        "profiles {profiles:?} tier {tier} seeds {first}..{} opts {opts:?}",
+        first + games
+    );
+    let (stats, failures) = run(&profiles, tier, first, games, &opts);
+    report(&stats, &failures);
+    assert!(failures.is_empty(), "{} failures", failures.len());
+}

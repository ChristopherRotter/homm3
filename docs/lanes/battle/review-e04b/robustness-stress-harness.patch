+/// How far one command fast-forwards: the attacker blinds the only stack of the defender, which
+/// frightens every attacker stack at each pick (fear 100 in the test ruleset): no stack acts until
+/// the Blind ends, power + duration bonus rounds later.
+#[test]
+#[ignore = "throwaway measurement"]
+fn one_command_runs_the_rounds_of_a_blind() {
+    for (durations, power) in [(0usize, 10u8), (0, 255), (10, 255), (60, 255)] {
+        let r = stress_ruleset("t:faithful", false, 20);
+        let blind = r.spell_by_key("t:blind").unwrap();
+        let mut s = super::support::setup(&r, &[(0, "fast", 10)], &[(0, "azure", 1000)]);
+        let mut h = hero(&r);
+        h.power = power;
+        h.magic.mana = 100;
+        h.magic.spell_book = Some(vec![blind]);
+        h.effects = vec![BattleEffect::SpellDuration { rounds: 255 }; durations];
+        s.heroes[0] = Some(h);
+        let mut state = BattleState::new(&r, &s, 3).unwrap();
+        assert_eq!(state.side_to_act(), Some(BattleSide::Attacker));
+        let mut events: Vec<Event> = Vec::new();
+        let cast = Command::Cast {
+            spell: blind,
+            target: CastTarget::Stack(StackId(1)),
+            second: CastTarget::None,
+        };
+        apply(&mut state, &r, BattleSide::Attacker, cast, &mut events).unwrap();
+        let rounds = state.effects().first().and_then(|e| e.rounds);
+        events.clear();
+        let t0 = Instant::now();
+        apply(
+            &mut state,
+            &r,
+            BattleSide::Attacker,
+            Command::Defend,
+            &mut events,
+        )
+        .unwrap();
+        println!(
+            "power {power}, {durations} duration effects: Blind for {rounds:?} rounds; Defend ran to round {} in {:?} with {} events; to act: {:?}",
+            state.round(),
+            t0.elapsed(),
+            events.len(),
+            state.side_to_act()
+        );
+    }
+}
+
+/// Field shapes of the synthetic ruleset: width, height, side columns, army slots.
+const SHAPES: &[(u8, u8, u8, u8)] = &[
+    (17, 15, 1, 7),
+    (15, 17, 1, 7),
+    (23, 11, 1, 7),
+    (51, 5, 1, 5),
+    (85, 3, 1, 3),
+    (255, 1, 1, 1),
+    (127, 2, 1, 2),
+    (4, 11, 1, 7),
+    (5, 11, 1, 7),
+    (6, 11, 1, 7),
+    (7, 11, 1, 7),
+    (2, 11, 0, 7),
+    (3, 11, 0, 7),
+    (4, 11, 0, 7),
+    (8, 16, 0, 16),
+    (15, 16, 1, 16),
+    (9, 11, 3, 7),
+    (12, 1, 0, 1),
+    (13, 2, 1, 2),
+    (17, 11, 1, 7),
+];
+
+/// The test ruleset with another field shape (formations, machine places and the tactics zones
+/// fitted to it), or the compiler's refusal.
+fn shaped_ruleset(
+    profile: &str,
+    lively: bool,
+    limit: u8,
+    (w, h, side, slots): (u8, u8, u8, u8),
+) -> Result<Ruleset, String> {
+    try_ruleset_from(
+        profile,
+        |b| {
+            if lively {
+                b.morale_dice = 4;
+                b.good_morale_chances = vec![1, 2, 3];
+                b.bad_morale_chances = vec![1, 2, 3];
+                b.luck_dice = 4;
+                b.good_luck_chances = vec![1, 2, 3];
+            }
+            b.side_stack_limit = limit;
+            b.field_width = w;
+            b.field_height = h;
+            b.side_columns = side;
+            b.army_slots = slots;
+            let x = side.max(1);
+            b.war_machine_positions = if h >= 3 {
+                vec![[x, h / 2], [x, 0], [x, h - 1]]
+            } else {
+                vec![[x, 0], [x + 2, 0], [x + 4, 0]]
+            };
+            b.loose_formation = (1..=slots)
+                .map(|n| {
+                    (0..n)
+                        .map(|i| u8::try_from(u32::from(i) * u32::from(h) / u32::from(n)).unwrap())
+                        .collect()
+                })
+                .collect();
+            b.tight_formation = (1..=slots)
+                .map(|n| (0..n).map(|i| (h - n) / 2 + i).collect())
+                .collect();
+            let standable = w - 2 * side;
+            b.tactics_zone_columns = vec![3.min(standable), 5.min(standable), 7.min(standable)];
+        },
+        |pack| {
+            // The pack's absolute obstacle blocks (5..=8, 4).
+            if u32::from(w) < 9 + u32::from(side) || h < 5 {
+                pack.obstacles.retain(|o| !o.absolute);
+            }
+        },
+    )
+    .map_err(|e| format!("{e:?}"))
+}
+
+/// Battles on other field shapes (`STRESS_GAMES` per shape, `STRESS_TIER`, `STRESS_SEED`;
+/// with tier 1 or 2 use `STRESS_SAFE=1`).
+#[test]
+#[ignore = "throwaway stress run"]
+fn stress_fields() {
+    let games = env("STRESS_GAMES", 200);
+    let first = env("STRESS_SEED", 1);
+    let tier = u8::try_from(env("STRESS_TIER", 0)).unwrap();
+    let opts = Opts {
+        steps: env("STRESS_STEPS", 200),
+        hero_cast: 40,
+        creature_cast: 35,
+        exhaustive_every: u32::try_from(env("STRESS_EXHAUSTIVE", 12)).unwrap(),
+        deep_every: 4,
+        count_events: false,
+        trace: env("STRESS_TRACE", 0) != 0,
+    };
+    std::panic::set_hook(std::boxed::Box::new(|info| {
+        *LAST_PANIC.lock().unwrap() = Some(format!("{info}"));
+    }));
+    let profiles = [
+        "t:faithful",
+        "t:original",
+        "t:anchors",
+        "t:quirky",
+        "t:pits",
+        "t:mirrored",
+    ];
+    let mut all_failures: Vec<(u64, String)> = Vec::new();
+    for &shape in SHAPES {
+        if let Ok(only) = std::env::var("STRESS_SHAPE") {
+            if format!("{}x{}", shape.0, shape.1) != only {
+                continue;
+            }
+        }
+        let mut rulesets = Vec::new();
+        let mut refused_rulesets = BTreeMap::<String, u64>::new();
+        for p in profiles {
+            for (lively, limit) in [(true, 12), (false, 21)] {
+                match catch_unwind(|| shaped_ruleset(p, lively, limit, shape)) {
+                    Ok(Ok(r)) => rulesets.push((p, r)),
+                    Ok(Err(e)) => *refused_rulesets.entry(e).or_default() += 1,
+                    Err(_) => {
+                        let msg = LAST_PANIC.lock().unwrap().take().unwrap_or_default();
+                        all_failures
+                            .push((0, format!("shape {shape:?}: PANIC in the compiler: {msg}")));
+                    }
+                }
+            }
+        }
+        if rulesets.is_empty() {
+            println!("shape {shape:?}: no ruleset: {refused_rulesets:?}");
+            continue;
+        }
+        let mut stats = Stats::default();
+        let mut failures: Vec<(u64, String)> = Vec::new();
+        let mut refusals = BTreeMap::<String, u64>::new();
+        for seed in first..first + games {
+            let (profile, r) = &rulesets[(seed % rulesets.len() as u64) as usize];
+            let mut rng = Rng::from_seed(seed ^ 0xf1e1_d000_0000_0000 ^ (u64::from(tier) << 40));
+            let made = catch_unwind(AssertUnwindSafe(|| setup(r, &mut rng, tier)));
+            let Ok(s) = made else {
+                let msg = LAST_PANIC.lock().unwrap().take().unwrap_or_default();
+                failures.push((
+                    seed,
+                    format!("shape {shape:?} seed {seed}: HARNESS PANIC in setup: {msg}"),
+                ));
+                continue;
+            };
+            stats.battles += 1;
+            let mut local = stats.clone();
+            let res = catch_unwind(AssertUnwindSafe(|| {
+                play_one(r, &s, seed, &opts, &mut local)
+            }));
+            let label = format!("shape {shape:?} tier {tier} seed {seed} profile {profile}");
+            match res {
+                Ok(Ok(())) => stats = local,
+                Ok(Err(e)) => {
+                    stats = local;
+                    if e.starts_with("setup refused") {
+                        let name: String = e.chars().filter(|c| !c.is_ascii_digit()).collect();
+                        *refusals.entry(name).or_default() += 1;
+                    } else {
+                        failures.push((seed, format!("{label}: {e}")));
+                    }
+                }
+                Err(_) => {
+                    let msg = LAST_PANIC.lock().unwrap().take().unwrap_or_default();
+                    failures.push((seed, format!("{label}: PANIC {msg}")));
+                }
+            }
+        }
+        println!(
+            "== shape {shape:?}: {} rulesets (refused: {refused_rulesets:?}); setups refused: {refusals:?}",
+            rulesets.len()
+        );
+        report(&stats, &failures);
+        all_failures.extend(failures);
+    }
+    let _ = std::panic::take_hook();
+    assert!(all_failures.is_empty(), "{} failures", all_failures.len());
+}
diff --git a/crates/h3-ffi/tests/fuzz.rs b/crates/h3-ffi/tests/fuzz.rs
new file mode 100644
index 0000000..363c6e3
--- /dev/null
+++ b/crates/h3-ffi/tests/fuzz.rs
@@ -0,0 +1,319 @@
+//! THROWAWAY fuzz of the C ABI for the E04b robustness review (T11b). Not committed.
+//!
+//! Every function with wrong sizes, sides and indices on the three synthetic scenarios; the
+//! legal actions chosen head by head from the masks. No call may answer `H3_ERR_PANIC`, write
+//! beyond the length the ABI promises, or change the state when it refuses.
+#![allow(unsafe_code)]
+
+use h3_ffi::*;
+use h3_kernel::Rng;
+
+fn env_var(name: &str, default: u64) -> u64 {
+    std::env::var(name)
+        .ok()
+        .and_then(|v| v.parse().ok())
+        .unwrap_or(default)
+}
+
+const CANARY: u8 = 0xA5;
+
+fn bits(mask: &[u8], n: usize) -> Vec<usize> {
+    assert!(mask[..n].iter().all(|b| *b <= 1), "a mask byte is not 0/1");
+    assert!(
+        mask[n..].iter().all(|b| *b == CANARY),
+        "a mask wrote beyond its length"
+    );
+    (0..n).filter(|&i| mask[i] == 1).collect()
+}
+
+#[test]
+#[ignore = "throwaway fuzz"]
+fn ffi_fuzz() {
+    let games = env_var("FUZZ_GAMES", 30);
+    let first = env_var("FUZZ_SEED", 1);
+    let steps = env_var("FUZZ_STEPS", 400);
+    let actions = h3_action_count() as usize;
+    let spells_n = h3_spell_count() as usize;
+    let targets_n = h3_target_count() as usize;
+    let obs_n = h3_observation_len() as usize;
+    let (mut calls, mut legal_steps, mut casts, mut refused, mut finished) =
+        (0u64, 0u64, 0u64, 0u64, 0u64);
+    let mut codes = std::collections::BTreeMap::<i32, u64>::new();
+    for seed in first..first + games {
+        let mut rng = Rng::from_seed(seed);
+        let scenario = (seed % 3) as u32;
+        let max_steps = if seed % 5 == 0 { 50 } else { 0 };
+        let env = h3_env_create_synthetic(scenario, seed, max_steps);
+        assert!(!env.is_null());
+        assert!(h3_env_create_synthetic(3 + rng.below(1000), seed, 0).is_null());
+        let mut mask = vec![CANARY; actions + 9];
+        let mut spells = vec![CANARY; spells_n + 9];
+        let mut targets = vec![CANARY; targets_n + 9];
+        let mut seconds = vec![CANARY; targets_n + 9];
+        let mut obs = vec![f32::NAN; obs_n + 5];
+        unsafe {
+            for _ in 0..steps {
+                let side = h3_env_to_move(env);
+                if side < 0 {
+                    finished += 1;
+                    // Everything refuses after the end, the masks are empty.
+                    let hash = h3_env_state_hash(env);
+                    let a = H3Action {
+                        entry: rng.below(actions as u32),
+                        spell: 0,
+                        target: 0,
+                        second: 0,
+                    };
+                    assert_eq!(
+                        h3_env_step(env, 0, a, std::ptr::null_mut()),
+                        H3_ERR_EPISODE_OVER
+                    );
+                    mask.fill(CANARY);
+                    assert_eq!(h3_env_legal_mask(env, 0, mask.as_mut_ptr(), actions), H3_OK);
+                    assert!(bits(&mask, actions).is_empty());
+                    assert_eq!(h3_env_state_hash(env), hash);
+                    assert_eq!(h3_env_reset(env, rng.next_u64()), H3_OK);
+                    continue;
+                }
+                let hash = h3_env_state_hash(env);
+                // Wrong sides and sizes.
+                for bad in [2, -1, i32::MIN, i32::MAX, 7] {
+                    calls += 5;
+                    assert_eq!(
+                        h3_env_legal_mask(env, bad, mask.as_mut_ptr(), actions),
+                        H3_ERR_ARGUMENT
+                    );
+                    assert_eq!(
+                        h3_env_spell_mask(env, bad, 0, spells.as_mut_ptr(), spells_n),
+                        H3_ERR_ARGUMENT
+                    );
+                    assert_eq!(
+                        h3_env_target_mask(env, bad, 0, 0, targets.as_mut_ptr(), targets_n),
+                        H3_ERR_ARGUMENT
+                    );
+                    assert_eq!(
+                        h3_env_second_mask(env, bad, 0, 0, 0, seconds.as_mut_ptr(), targets_n),
+                        H3_ERR_ARGUMENT
+                    );
+                    assert_eq!(
+                        h3_env_observe(env, bad, obs.as_mut_ptr(), obs_n),
+                        H3_ERR_ARGUMENT
+                    );
+                    assert_eq!(
+                        h3_env_step(env, bad, H3Action::default(), std::ptr::null_mut()),
+                        H3_ERR_ARGUMENT
+                    );
+                }
+                for short in [0, 1, actions - 1] {
+                    assert_eq!(
+                        h3_env_legal_mask(env, side, mask.as_mut_ptr(), short),
+                        H3_ERR_ARGUMENT
+                    );
+                }
+                assert_eq!(
+                    h3_env_spell_mask(env, side, 0, spells.as_mut_ptr(), spells_n - 1),
+                    H3_ERR_ARGUMENT
+                );
+                assert_eq!(
+                    h3_env_target_mask(env, side, 0, 0, targets.as_mut_ptr(), targets_n - 1),
+                    H3_ERR_ARGUMENT
+                );
+                assert_eq!(
+                    h3_env_second_mask(env, side, 0, 0, 0, seconds.as_mut_ptr(), targets_n - 1),
+                    H3_ERR_ARGUMENT
+                );
+                assert_eq!(
+                    h3_env_observe(env, side, obs.as_mut_ptr(), obs_n - 1),
+                    H3_ERR_ARGUMENT
+                );
+                assert!(mask.iter().all(|b| *b == CANARY || *b <= 1));
+                // The observation, with a longer buffer: only its length is written.
+                obs.fill(f32::NAN);
+                assert_eq!(
+                    h3_env_observe(env, side, obs.as_mut_ptr(), obs_n + 5),
+                    H3_OK
+                );
+                assert!(obs[..obs_n].iter().all(|v| v.is_finite()));
+                assert!(obs[obs_n..].iter().all(|v| v.is_nan()));
+                assert_eq!(
+                    h3_env_observe(env, 1 - side, obs.as_mut_ptr(), obs_n),
+                    H3_OK
+                );
+                // Arbitrary prefixes for the head masks and arbitrary actions.
+                for _ in 0..40 {
+                    let entry = match rng.below(4) {
+                        0 => rng.below(actions as u32 + 8),
+                        1 => actions as u32 - 2 + rng.below(2),
+                        2 => rng.next_u32(),
+                        _ => u32::MAX - rng.below(3),
+                    };
+                    let spell = match rng.below(3) {
+                        0 => 0,
+                        1 => rng.below(spells_n as u32 + 8) as u16,
+                        _ => rng.below(65_536) as u16,
+                    };
+                    let target = match rng.below(3) {
+                        0 => 0,
+                        1 => rng.below(targets_n as u32 + 8) as u16,
+                        _ => rng.below(65_536) as u16,
+                    };
+                    let second = match rng.below(3) {
+                        0 => 0,
+                        1 => rng.below(targets_n as u32 + 8) as u16,
+                        _ => rng.below(65_536) as u16,
+                    };
+                    let actor = if rng.below(6) == 0 { 1 - side } else { side };
+                    spells.fill(CANARY);
+                    targets.fill(CANARY);
+                    seconds.fill(CANARY);
+                    calls += 4;
+                    assert_eq!(
+                        h3_env_spell_mask(env, actor, entry, spells.as_mut_ptr(), spells_n + 3),
+                        H3_OK
+                    );
+                    let s = bits(&spells, spells_n);
+                    assert_eq!(
+                        h3_env_target_mask(
+                            env,
+                            actor,
+                            entry,
+                            spell,
+                            targets.as_mut_ptr(),
+                            targets_n
+                        ),
+                        H3_OK
+                    );
+                    let t = bits(&targets, targets_n);
+                    assert_eq!(
+                        h3_env_second_mask(
+                            env,
+                            actor,
+                            entry,
+                            spell,
+                            target,
+                            seconds.as_mut_ptr(),
+                            targets_n
+                        ),
+                        H3_OK
+                    );
+                    let s2 = bits(&seconds, targets_n);
+                    let listed = actor == side
+                        && s.contains(&usize::from(spell))
+                        && t.contains(&usize::from(target))
+                        && s2.contains(&usize::from(second));
+                    // On a fork, so that an accepted arbitrary action does not steer the game.
+                    let fork = h3_env_fork(env);
+                    assert!(!fork.is_null());
+                    let a = H3Action {
+                        entry,
+                        spell,
+                        target,
+                        second,
+                    };
+                    let mut result = H3StepResult::default();
+                    let code = h3_env_step(fork, actor, a, &mut result);
+                    *codes.entry(code).or_default() += 1;
+                    assert_ne!(code, H3_ERR_PANIC, "{a:?} panicked (seed {seed})");
+                    assert!(
+                        [H3_OK, H3_ERR_INVALID_ACTION, H3_ERR_REJECTED].contains(&code),
+                        "{a:?}: code {code}"
+                    );
+                    assert_eq!(
+                        code == H3_OK,
+                        listed,
+                        "{a:?} for {actor} (to move {side}): code {code}, listed {listed} (seed {seed})"
+                    );
+                    if code != H3_OK {
+                        refused += 1;
+                        assert_eq!(
+                            h3_env_state_hash(fork),
+                            hash,
+                            "a refused step changed the state"
+                        );
+                    }
+                    h3_env_destroy(fork);
+                }
+                // A legal action, head by head.
+                mask.fill(CANARY);
+                assert_eq!(
+                    h3_env_legal_mask(env, side, mask.as_mut_ptr(), actions + 9),
+                    H3_OK
+                );
+                let entries = bits(&mask, actions);
+                assert!(!entries.is_empty());
+                // Casts when they are possible, else no leaving.
+                let hero = actions - 2;
+                let creature = actions - 1;
+                let entry = if mask[hero] == 1 && rng.below(100) < 50 {
+                    hero
+                } else if mask[creature] == 1 && rng.below(100) < 60 {
+                    creature
+                } else {
+                    let staying: Vec<usize> = entries
+                        .iter()
+                        .copied()
+                        .filter(|&e| e < actions - 4)
+                        .collect();
+                    if staying.is_empty() {
+                        entries[rng.below(entries.len() as u32) as usize]
+                    } else {
+                        staying[rng.below(staying.len() as u32) as usize]
+                    }
+                } as u32;
+                spells.fill(CANARY);
+                targets.fill(CANARY);
+                seconds.fill(CANARY);
+                assert_eq!(
+                    h3_env_spell_mask(env, side, entry, spells.as_mut_ptr(), spells_n),
+                    H3_OK
+                );
+                let s = bits(&spells, spells_n);
+                assert!(!s.is_empty(), "entry {entry}: no spell");
+                let spell = s[rng.below(s.len() as u32) as usize] as u16;
+                assert_eq!(
+                    h3_env_target_mask(env, side, entry, spell, targets.as_mut_ptr(), targets_n),
+                    H3_OK
+                );
+                let t = bits(&targets, targets_n);
+                assert!(!t.is_empty(), "entry {entry} spell {spell}: no target");
+                let target = t[rng.below(t.len() as u32) as usize] as u16;
+                assert_eq!(
+                    h3_env_second_mask(
+                        env,
+                        side,
+                        entry,
+                        spell,
+                        target,
+                        seconds.as_mut_ptr(),
+                        targets_n
+                    ),
+                    H3_OK
+                );
+                let s2 = bits(&seconds, targets_n);
+                assert!(
+                    !s2.is_empty(),
+                    "entry {entry} spell {spell} target {target}: no second"
+                );
+                let second = s2[rng.below(s2.len() as u32) as usize] as u16;
+                let a = H3Action {
+                    entry,
+                    spell,
+                    target,
+                    second,
+                };
+                assert_eq!(h3_env_state_hash(env), hash);
+                let mut result = H3StepResult::default();
+                let code = h3_env_step(env, side, a, &mut result);
+                assert_eq!(code, H3_OK, "the listed {a:?} was refused (seed {seed})");
+                legal_steps += 1;
+                casts += u64::from(entry as usize >= hero);
+                assert!(result.done <= 1 && result.truncated <= 1);
+                assert!((-1..=6).contains(&result.result));
+            }
+            h3_env_destroy(env);
+        }
+    }
+    println!(
+        "games {games}, legal steps {legal_steps} ({casts} casts), finished episodes {finished}, arbitrary steps refused {refused}, mask calls {calls}, codes {codes:?}"
+    );
+}
diff --git a/crates/h3-pack/tests/fuzz_pack.rs b/crates/h3-pack/tests/fuzz_pack.rs
new file mode 100644
index 0000000..d08fad6
--- /dev/null
+++ b/crates/h3-pack/tests/fuzz_pack.rs
@@ -0,0 +1,524 @@
+//! THROWAWAY mutation fuzz of the harvested base pack for the E04b robustness review (T11b).
+//! Not committed.
+//!
+//! Each trial mutates one to three values of a spell, a creature, an obstacle type or the battle
+//! parameters in the pack's text (numbers to extremes, flags flipped, a string to another value
+//! of the same key, a line dropped or borrowed from another table) and compiles the three packs.
+//! A refusal is the right answer for an invalid pack; a pack the compiler accepts must play:
+//! battles that use what was mutated, with casts, every listed command accepted, no panic, no
+//! command that runs for ever (a watchdog thread).
+
+use std::collections::BTreeMap;
+use std::panic::{AssertUnwindSafe, catch_unwind};
+use std::sync::{Arc, Mutex, mpsc};
+use std::time::Duration;
+
+use h3_battle::{
+    BattleState, CastTargets, Command, LegalCommands, NoopSink, apply, cast_targets,
+    castable_spells, creature_cast_targets, generate_obstacles, legal_commands, observe,
+    second_targets,
+};
+use h3_content::{
+    CreatureFlag, CreatureTypeId, Formation, HeroTypeId, Ruleset, SpellCategory, SpellId, TerrainId,
+};
+use h3_contracts::{Army, ArmyStack, BattleHero, BattleSetup, BattleSide};
+use h3_kernel::{Rng, StreamId};
+
+static LAST_PANIC: Mutex<Option<String>> = Mutex::new(None);
+
+fn env_var(name: &str, default: u64) -> u64 {
+    std::env::var(name)
+        .ok()
+        .and_then(|v| v.parse().ok())
+        .unwrap_or(default)
+}
+
+fn pick(rng: &mut Rng, n: usize) -> usize {
+    rng.below(u32::try_from(n).unwrap()) as usize
+}
+
+const KINDS: &[&str] = &["spell", "creature", "obstacle", "battle", "spell_school"];
+const NUMBERS: &[&str] = &[
+    "0",
+    "1",
+    "2",
+    "3",
+    "4",
+    "7",
+    "16",
+    "17",
+    "100",
+    "101",
+    "254",
+    "255",
+    "256",
+    "1000",
+    "10000",
+    "10001",
+    "32767",
+    "65535",
+    "65536",
+    "4294967295",
+    "4294967296",
+    "-1",
+];
+
+/// One line of a table the fuzz may mutate.
+#[derive(Clone)]
+struct Line {
+    index: usize,
+    kind: &'static str,
+    id: String,
+    key: String,
+}
+
+struct Source {
+    lines: Vec<String>,
+    candidates: Vec<Line>,
+    /// The values seen per `kind.key`.
+    values: BTreeMap<String, Vec<String>>,
+}
+
+fn scan(text: &str) -> Source {
+    let lines: Vec<String> = text.lines().map(str::to_owned).collect();
+    let mut candidates = Vec::new();
+    let mut values: BTreeMap<String, Vec<String>> = BTreeMap::new();
+    let mut kind: Option<&'static str> = None;
+    let mut id = String::new();
+    for (index, line) in lines.iter().enumerate() {
+        let t = line.trim();
+        if t.starts_with('[') {
+            let name = t.trim_matches(|c| c == '[' || c == ']');
+            kind = KINDS.iter().copied().find(|k| *k == name);
+            id = String::new();
+            continue;
+        }
+        let Some(kind) = kind else { continue };
+        let Some((key, value)) = t.split_once(" = ") else {
+            continue;
+        };
+        if key == "id" {
+            id = value.split('"').nth(1).unwrap_or("").to_owned();
+            continue;
+        }
+        if key == "name" || key == "plural" {
+            continue;
+        }
+        let known = values.entry(format!("{kind}.{key}")).or_default();
+        if !known.iter().any(|v| v == value) {
+            known.push(value.to_owned());
+        }
+        candidates.push(Line {
+            index,
+            kind,
+            id: id.clone(),
+            key: key.to_owned(),
+        });
+    }
+    Source {
+        lines,
+        candidates,
+        values,
+    }
+}
+
+/// What a trial changed: the description and the spells and creatures it touched.
+struct Mutation {
+    text: String,
+    what: Vec<String>,
+    spells: Vec<String>,
+    creatures: Vec<String>,
+}
+
+fn mutate(src: &Source, rng: &mut Rng) -> Mutation {
+    let mut lines = src.lines.clone();
+    let mut what = Vec::new();
+    let (mut spells, mut creatures) = (Vec::new(), Vec::new());
+    for _ in 0..1 + rng.below(3) {
+        // Spells and creatures more often than the rest.
+        let line = loop {
+            let l = &src.candidates[pick(rng, src.candidates.len())];
+            if matches!(l.kind, "spell" | "creature") || rng.below(4) == 0 {
+                break l.clone();
+            }
+        };
+        let old = lines[line.index].clone();
+        let (key, value) = old.split_once(" = ").map_or(("", ""), |(k, v)| (k, v));
+        let new = match rng.below(10) {
+            // A number to an extreme.
+            0..=5 => {
+                let spans: Vec<(usize, usize)> = {
+                    let b = value.as_bytes();
+                    let mut out = Vec::new();
+                    let mut i = 0;
+                    let mut quoted = false;
+                    while i < b.len() {
+                        if b[i] == b'"' {
+                            quoted = !quoted;
+                        }
+                        if !quoted
+                            && b[i].is_ascii_digit()
+                            && (i == 0 || !b[i - 1].is_ascii_alphanumeric() && b[i - 1] != b'_')
+                        {
+                            let start = if i > 0 && b[i - 1] == b'-' { i - 1 } else { i };
+                            let mut j = i;
+                            while j < b.len() && b[j].is_ascii_digit() {
+                                j += 1;
+                            }
+                            out.push((start, j));
+                            i = j;
+                        } else {
+                            i += 1;
+                        }
+                    }
+                    out
+                };
+                if spans.is_empty() {
+                    continue;
+                }
+                let (a, b) = spans[pick(rng, spans.len())];
+                let n = NUMBERS[pick(rng, NUMBERS.len())];
+                format!("{key} = {}{n}{}", &value[..a], &value[b..])
+            }
+            // A flag flipped.
+            6 if value.contains("true") || value.contains("false") => {
+                let v = if value.contains("true") {
+                    value.replacen("true", "false", 1)
+                } else {
+                    value.replacen("false", "true", 1)
+                };
+                format!("{key} = {v}")
+            }
+            // Another value of the same key.
+            6 | 7 => {
+                let known = &src.values[&format!("{}.{}", line.kind, line.key)];
+                format!("{key} = {}", known[pick(rng, known.len())])
+            }
+            // The line dropped.
+            8 => String::new(),
+            // A line of another table of the kind added.
+            _ => {
+                let others: Vec<&Line> = src
+                    .candidates
+                    .iter()
+                    .filter(|l| l.kind == line.kind && l.key != line.key)
+                    .collect();
+                if others.is_empty() {
+                    continue;
+                }
+                let other = others[pick(rng, others.len())];
+                format!("{old}\n{}", src.lines[other.index])
+            }
+        };
+        if new == old {
+            continue;
+        }
+        what.push(format!(
+            "{} {:?}: `{}` -> `{}`",
+            line.kind,
+            line.id,
+            old.trim(),
+            new.replace('\n', " + ")
+        ));
+        lines[line.index] = new;
+        match line.kind {
+            "spell" => spells.push(format!("base:{}", line.id)),
+            "creature" => creatures.push(format!("base:{}", line.id)),
+            _ => {}
+        }
+    }
+    Mutation {
+        text: lines.join("\n"),
+        what,
+        spells,
+        creatures,
+    }
+}
+
+/// Plays battles on `r` that use the mutated spells and creatures; `Err` names the first failure.
+fn play(r: &Ruleset, m: &Mutation, seed: u64) -> Result<(u32, u32), String> {
+    let mut rng = Rng::from_seed(seed ^ 0xf00d);
+    let pool: Vec<CreatureTypeId> = (0..r.creature_count())
+        .filter_map(CreatureTypeId::from_index)
+        .filter(|&c| {
+            r.creature(c)
+                .is_some_and(|t| !t.flags.contains(CreatureFlag::WarMachine))
+        })
+        .collect();
+    if pool.is_empty() || r.hero_types().is_empty() {
+        return Ok((0, 0));
+    }
+    let mutated_spells: Vec<SpellId> = m.spells.iter().filter_map(|k| r.spell_by_key(k)).collect();
+    let mutated: Vec<CreatureTypeId> = m
+        .creatures
+        .iter()
+        .filter_map(|k| r.creature_by_key(k))
+        .collect();
+    let hero_spells: Vec<SpellId> = (0..r.spells().len())
+        .filter_map(SpellId::from_index)
+        .filter(|&s| {
+            r.spell(s)
+                .is_some_and(|t| t.category != SpellCategory::Ability)
+        })
+        .collect();
+    let slots = r.battle().army_slots.min(7);
+    let mut casts = (0, 0);
+    for game in 0..3u64 {
+        let mut hero = |rng: &mut Rng| {
+            let mut h = BattleHero::new(HeroTypeId::from_index(0).unwrap());
+            h.power = [1, 5, 20, 60][pick(rng, 4)];
+            h.magic.mana = 999;
+            h.magic.spell_book = Some(hero_spells.clone());
+            h.magic.masteries = (0..r.spells().len())
+                .filter_map(SpellId::from_index)
+                .filter_map(|s| {
+                    let level = u8::try_from(rng.below(4)).unwrap();
+                    (level > 0).then_some((s, level))
+                })
+                .collect();
+            h
+        };
+        let mut army = |rng: &mut Rng| -> (Army, Vec<CreatureTypeId>) {
+            let mut machines = Vec::new();
+            let mut stacks = Vec::new();
+            for slot in 0..=rng.below(u32::from(slots)) {
+                let creature = if !mutated.is_empty() && rng.below(2) == 0 {
+                    mutated[pick(rng, mutated.len())]
+                } else {
+                    pool[pick(rng, pool.len())]
+                };
+                if r.creature(creature)
+                    .is_some_and(|t| t.flags.contains(CreatureFlag::WarMachine))
+                {
+                    if !machines.contains(&creature) {
+                        machines.push(creature);
+                    }
+                    continue;
+                }
+                stacks.push(ArmyStack {
+                    slot: u8::try_from(slot).unwrap(),
+                    creature,
+                    count: [1, 7, 60, 2000, 100_000][pick(rng, 5)],
+                });
+            }
+            if stacks.is_empty() {
+                stacks.push(ArmyStack {
+                    slot: 0,
+                    creature: pool[pick(rng, pool.len())],
+                    count: 10,
+                });
+            }
+            (Army { stacks }, machines)
+        };
+        let (attacker, am) = army(&mut rng);
+        let (defender, dm) = army(&mut rng);
+        let terrain = (rng.below(3) != 0 && !r.terrains().is_empty())
+            .then(|| TerrainId::from_index(pick(&mut rng, r.terrains().len())))
+            .flatten();
+        let obstacles = terrain.map_or_else(Vec::new, |t| {
+            generate_obstacles(r, t, &mut Rng::for_stream(seed ^ game, StreamId::OBSTACLES))
+        });
+        let setup = BattleSetup {
+            attacker,
+            defender,
+            obstacles,
+            heroes: [
+                Some(hero(&mut rng)),
+                (rng.below(4) != 0).then(|| hero(&mut rng)),
+            ],
+            terrain,
+            war_machines: [am, dm],
+            formations: [Formation::Loose, Formation::Tight],
+            funds: [10_000, 0],
+        };
+        // A refused setup is an answer (no room on a mutated field, a generated battlefield the
+        // battle refuses: F-robust-5).
+        let Ok(mut state) = BattleState::new(r, &setup, seed ^ game) else {
+            continue;
+        };
+        let mut legal = LegalCommands::new();
+        let mut targets = CastTargets::new();
+        let mut seconds = CastTargets::new();
+        for step in 0..150 {
+            let Some(side) = state.side_to_act() else {
+                break;
+            };
+            let spells: Vec<SpellId> = castable_spells(&state, r, side).iter().collect();
+            creature_cast_targets(&state, r, side, &mut targets);
+            let roll = rng.below(100);
+            let cmd = if !spells.is_empty() && roll < 55 {
+                let wanted: Vec<SpellId> = spells
+                    .iter()
+                    .copied()
+                    .filter(|s| mutated_spells.contains(s))
+                    .collect();
+                let spell = if !wanted.is_empty() && rng.below(4) != 0 {
+                    wanted[pick(&mut rng, wanted.len())]
+                } else {
+                    spells[pick(&mut rng, spells.len())]
+                };
+                cast_targets(&state, r, side, spell, &mut targets);
+                if targets.is_empty() {
+                    // F-robust-2 on a generated battlefield: known.
+                    let key = r.spell(spell).map_or("?", |s| s.key.as_str());
+                    if key == "base:remove_obstacle" {
+                        break;
+                    }
+                    return Err(format!("step {step}: castable {key} without a target"));
+                }
+                let target = targets.as_slice()[pick(&mut rng, targets.len())];
+                second_targets(&state, r, side, (spell, target), &mut seconds);
+                if seconds.is_empty() {
+                    return Err(format!(
+                        "step {step}: {spell:?} at {target:?} without a second target"
+                    ));
+                }
+                casts.0 += 1;
+                Command::Cast {
+                    spell,
+                    target,
+                    second: seconds.as_slice()[pick(&mut rng, seconds.len())],
+                }
+            } else if !targets.is_empty() && roll < 85 {
+                casts.1 += 1;
+                Command::CreatureCast {
+                    target: targets.as_slice()[pick(&mut rng, targets.len())],
+                }
+            } else {
+                legal_commands(&state, r, side, &mut legal);
+                let staying: Vec<Command> = legal
+                    .iter()
+                    .copied()
+                    .filter(|c| !c.leaves_battle())
+                    .collect();
+                if staying.is_empty() {
+                    return Err(format!("step {step}: no legal command"));
+                }
+                let strikes: Vec<Command> = staying
+                    .iter()
+                    .copied()
+                    .filter(|c| matches!(c, Command::Attack { .. } | Command::Shoot { .. }))
+                    .collect();
+                if !strikes.is_empty() && rng.below(2) == 0 {
+                    strikes[pick(&mut rng, strikes.len())]
+                } else {
+                    staying[pick(&mut rng, staying.len())]
+                }
+            };
+            apply(&mut state, r, side, cmd, &mut NoopSink)
+                .map_err(|e| format!("step {step}: the listed {cmd:?} is rejected: {e:?}"))?;
+        }
+        for side in BattleSide::BOTH {
+            let _ = observe(&state, r, side);
+        }
+        if state.is_over() != state.outcome().is_some() {
+            return Err("over without an outcome".into());
+        }
+    }
+    Ok(casts)
+}
+
+/// `FUZZ_TRIALS`, `FUZZ_SEED`. Exits with code 3 at the first trial that does not return within
+/// 20 seconds (its mutation is printed first).
+#[test]
+#[ignore = "throwaway fuzz"]
+fn fuzz_pack() {
+    let trials = env_var("FUZZ_TRIALS", 300);
+    let first = env_var("FUZZ_SEED", 1);
+    let src = Arc::new(scan(h3_pack::BASE_PACK));
+    println!(
+        "{} lines, {} candidates",
+        src.lines.len(),
+        src.candidates.len()
+    );
+    std::panic::set_hook(Box::new(|info| {
+        *LAST_PANIC.lock().unwrap() = Some(format!("{info}"));
+    }));
+    let (mut compiled, mut refused, mut battles_ok) = (0u64, 0u64, 0u64);
+    let mut casts = (0u64, 0u64);
+    let mut refusals: BTreeMap<String, u64> = BTreeMap::new();
+    let mut failures: BTreeMap<String, (u64, String)> = BTreeMap::new();
+    for seed in first..first + trials {
+        let (done, wait) = mpsc::channel();
+        let src2 = src.clone();
+        std::thread::spawn(move || {
+            let mut rng = Rng::from_seed(seed);
+            let m = mutate(&src2, &mut rng);
+            let what = m.what.join("; ");
+            let _ = done.send((what.clone(), None));
+            let profile = if seed % 2 == 0 {
+                "base:faithful"
+            } else {
+                "base:strict-fixed"
+            };
+            let outcome = catch_unwind(AssertUnwindSafe(|| {
+                match h3_pack::compile(&[h3_pack::SOD_PACK, h3_pack::AB_PACK, &m.text], profile) {
+                    Err(e) => Err(format!("{e:?}")),
+                    Ok(r) => Ok(play(&r, &m, seed)),
+                }
+            }));
+            let result = match outcome {
+                Err(_) => {
+                    let msg = LAST_PANIC.lock().unwrap().take().unwrap_or_default();
+                    Some(Err(format!("PANIC {msg}")))
+                }
+                Ok(Err(e)) => Some(Ok(Err(e))),
+                Ok(Ok(Err(e))) => Some(Err(e)),
+                Ok(Ok(Ok(c))) => Some(Ok(Ok(c))),
+            };
+            let _ = done.send((what, result));
+        });
+        let Ok((what, _)) = wait.recv() else {
+            let msg = LAST_PANIC.lock().unwrap().take().unwrap_or_default();
+            let entry = failures
+                .entry(format!("HARNESS {msg}"))
+                .or_insert((0, format!("seed {seed}: the harness panicked: {msg}")));
+            entry.0 += 1;
+            continue;
+        };
+        match wait.recv_timeout(Duration::from_secs(20)) {
+            Err(_) => {
+                println!("HANG seed {seed}: {what}");
+                std::process::exit(3);
+            }
+            Ok((_, Some(Ok(Err(e))))) => {
+                refused += 1;
+                let name: String = e.chars().filter(|c| !c.is_ascii_digit()).take(70).collect();
+                *refusals.entry(name).or_default() += 1;
+            }
+            Ok((_, Some(Ok(Ok(c))))) => {
+                compiled += 1;
+                battles_ok += 1;
+                casts = (casts.0 + u64::from(c.0), casts.1 + u64::from(c.1));
+            }
+            Ok((what, Some(Err(e)))) => {
+                compiled += 1;
+                let key: String = e
+                    .chars()
+                    .filter(|c| !c.is_ascii_digit())
+                    .take(110)
+                    .collect();
+                let entry = failures
+                    .entry(key)
+                    .or_insert((0, format!("seed {seed}: {e}\n      mutation: {what}")));
+                entry.0 += 1;
+            }
+            Ok((_, None)) => unreachable!(),
+        }
+    }
+    let _ = std::panic::take_hook();
+    println!(
+        "trials {trials}: refused {refused}, compiled {compiled} (played without a failure {battles_ok}); casts {casts:?}"
+    );
+    let mut top: Vec<_> = refusals.iter().collect();
+    top.sort_by(|a, b| b.1.cmp(a.1).then(a.0.cmp(b.0)));
+    println!(
+        "refusals ({} kinds), the most frequent: {:?}",
+        top.len(),
+        &top[..top.len().min(12)]
+    );
+    println!("{} failure groups", failures.len());
+    for (n, first) in failures.values() {
+        println!("  x{n}: {first}");
+    }
+}

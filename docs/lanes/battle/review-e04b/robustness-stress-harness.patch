+/// One random corruption of a setup: something `BattleState::new` should refuse (or, by chance,
+/// accept).
+fn corrupt(s: &mut BattleSetup, rng: &mut Rng, r: &Ruleset) {
+    let any_spell = |rng: &mut Rng| SpellId::from_raw(u16::try_from(rng.below(300)).unwrap());
+    let any_creature =
+        |rng: &mut Rng| CreatureTypeId::from_raw(u16::try_from(rng.below(400)).unwrap());
+    let side = rng.below(2) as usize;
+    let kind = rng.below(34);
+    if (kind <= 3 || kind == 5)
+        && (if side == 0 { &s.attacker } else { &s.defender })
+            .stacks
+            .is_empty()
+    {
+        return;
+    }
+    match kind {
+        0 => {
+            let army = if side == 0 {
+                &mut s.attacker
+            } else {
+                &mut s.defender
+            };
+            army.stacks[0].slot = u8::try_from(rng.below(256)).unwrap();
+        }
+        1 => {
+            let army = if side == 0 {
+                &mut s.attacker
+            } else {
+                &mut s.defender
+            };
+            army.stacks[0].count = 0;
+        }
+        2 => {
+            let army = if side == 0 {
+                &mut s.attacker
+            } else {
+                &mut s.defender
+            };
+            army.stacks[0].creature = any_creature(rng);
+        }
+        3 => {
+            let army = if side == 0 {
+                &mut s.attacker
+            } else {
+                &mut s.defender
+            };
+            let first = army.stacks[0];
+            army.stacks.push(first);
+        }
+        4 => {
+            let army = if side == 0 {
+                &mut s.attacker
+            } else {
+                &mut s.defender
+            };
+            army.stacks.clear();
+        }
+        5 => {
+            let army = if side == 0 {
+                &mut s.attacker
+            } else {
+                &mut s.defender
+            };
+            let first = army.stacks[0];
+            army.stacks = (0..40).map(|i| ArmyStack { slot: i, ..first }).collect();
+        }
+        6 => s.war_machines[side].push(any_creature(rng)),
+        7 => {
+            let m = s.war_machines[side].clone();
+            s.war_machines[side].extend(m);
+            s.war_machines[side].push(r.creature_by_key("t:gadget").unwrap());
+        }
+        8 => s.obstacles.push(Obstacle {
+            hexes: vec![u8::try_from(rng.below(256)).unwrap()],
+            anchor: Some(u8::try_from(rng.below(256)).unwrap()),
+        }),
+        9 => {
+            let h = u8::try_from(40 + rng.below(8)).unwrap();
+            s.obstacles.push(Obstacle {
+                hexes: vec![h, h],
+                anchor: None,
+            });
+        }
+        10 => {
+            for i in 0..40u8 {
+                s.obstacles.push(Obstacle {
+                    hexes: vec![],
+                    anchor: Some(36 + i % 10),
+                });
+            }
+        }
+        11 => s.obstacles.push(Obstacle {
+            hexes: (36..36 + 12).collect(),
+            anchor: Some(36),
+        }),
+        12 => {
+            s.terrain = Some(h3_content::TerrainId::from_raw(
+                u16::try_from(rng.below(60)).unwrap(),
+            ))
+        }
+        _ => {
+            let Some(h) = s.heroes[side].as_mut() else {
+                return;
+            };
+            match rng.below(24) {
+                0 => {
+                    h.hero_type =
+                        h3_content::HeroTypeId::from_raw(u16::try_from(rng.below(9)).unwrap())
+                }
+                1 => h.tactics = u8::try_from(4 + rng.below(252)).unwrap(),
+                2 => h.damage.reduction = Rate::bp(10_001 + rng.below(1_000_000)),
+                3 => {
+                    h.damage.reduction.single =
+                        NonZeroU32::new(0x3f80_0001 + rng.below(0x4000_0000))
+                }
+                4 => {
+                    h.war_machines.ballista = Some(BallistaControl {
+                        shots: u8::try_from(rng.below(2)).unwrap(),
+                        double_damage_chance_bp: u16::try_from(rng.below(65_536)).unwrap(),
+                    });
+                }
+                5 => h.surrender_discount_bp = u16::try_from(10_001 + rng.below(55_535)).unwrap(),
+                6 => {
+                    let e = BattleEffect::MindImmunity;
+                    h.effects.extend(core::iter::repeat_n(e, 70));
+                }
+                7 => h.effects.push(BattleEffect::NoRangePenalty {
+                    creatures: CreatureSelector::Creature(any_creature(rng)),
+                }),
+                8 => {
+                    let ids: Vec<_> = (0..3)
+                        .map(|_| {
+                            h3_content::FactionId::from_raw(u16::try_from(rng.below(9)).unwrap())
+                        })
+                        .collect();
+                    if let Some(factions) = FactionGroup::new(&ids) {
+                        h.effects.push(BattleEffect::AlignmentGroup { factions });
+                    }
+                }
+                9 => h.effects.push(BattleEffect::SpellDamage {
+                    scope: SpellScope::School(SchoolId::from_raw(
+                        u16::try_from(rng.below(9)).unwrap(),
+                    )),
+                    rate: Rate::bp(100),
+                }),
+                10 => h.effects.push(BattleEffect::SpellDamage {
+                    scope: SpellScope::Spell(any_spell(rng)),
+                    rate: Rate::bp(100),
+                }),
+                11 => h.effects.push(BattleEffect::SpellSpecialty {
+                    spell: any_spell(rng),
+                    bp_per_level: 300,
+                    level: 3,
+                }),
+                12 => h.effects.push(BattleEffect::SpellImmunity {
+                    spell: any_spell(rng),
+                }),
+                13 => h.effects.push(BattleEffect::OpeningSpell {
+                    spell: any_spell(rng),
+                    mastery: u8::try_from(rng.below(6)).unwrap(),
+                    power: u16::try_from(rng.below(3)).unwrap(),
+                }),
+                14 => {
+                    // More opening spells than the battle keeps.
+                    if let Some(&(spell, mastery)) = openings(r).first() {
+                        let e = BattleEffect::OpeningSpell {
+                            spell,
+                            mastery,
+                            power: 1,
+                        };
+                        h.effects.extend(core::iter::repeat_n(e, 9));
+                    }
+                }
+                15 => {
+                    // More spells with bonuses of their own than the battle keeps.
+                    for i in 0..6u16 {
+                        h.effects.push(BattleEffect::SpellSpecialty {
+                            spell: SpellId::from_raw(i),
+                            bp_per_level: 300,
+                            level: 3,
+                        });
+                    }
+                }
+                16 => h
+                    .magic
+                    .masteries
+                    .push((any_spell(rng), u8::try_from(rng.below(6)).unwrap())),
+                17 => {
+                    if let Some(&m) = h.magic.masteries.first() {
+                        h.magic.masteries.push(m);
+                    }
+                }
+                18 => {
+                    let book = h.magic.spell_book.get_or_insert_with(Vec::new);
+                    book.push(any_spell(rng));
+                }
+                19 => {
+                    let book = h.magic.spell_book.get_or_insert_with(Vec::new);
+                    if let Some(&first) = book.first() {
+                        book.push(first);
+                    }
+                }
+                20 => {
+                    h.magic.eagle_eye = Some(EagleEye {
+                        chance: Rate::bp(10_001 + rng.below(100_000)),
+                        spells: vec![],
+                    });
+                }
+                21 => {
+                    h.magic.eagle_eye = Some(EagleEye {
+                        chance: Rate {
+                            bp: 5000,
+                            single: NonZeroU32::new(rng.next_u32()),
+                        },
+                        spells: vec![any_spell(rng), any_spell(rng)],
+                    });
+                }
+                22 => h.effects.push(BattleEffect::StackStat {
+                    creatures: CreatureSelector::Creature(any_creature(rng)),
+                    stat: CreatureStat::Speed,
+                    op: StatOp::Add,
+                    amount: 1,
+                }),
+                _ => h.effects.push(BattleEffect::Regeneration {
+                    creatures: CreatureSelector::Creature(any_creature(rng)),
+                    hit_points: 5,
+                }),
+            }
+        }
+    }
+}
